{
  "version": 1,
  "description": "Operational lineage for local data artifacts. Convex remains authoritative for live runtime data unless an entry says otherwise.",
  "artifacts": [
    {
      "id": "substance-index-export",
      "path": "src/data/SubstanceIndex.json",
      "role": "derived-export",
      "producer": "scripts/convex/export-convex-to-json.mjs",
      "consumers": [
        "scripts/convex/convex-import-substance-index.mjs",
        "scripts/convex/import-to-convex.mjs",
        "scripts/prepopulate/*.mjs",
        "Next.js static fallback reads"
      ],
      "inputs": [
        "Convex substance records",
        "src/schema/substance.schema.ts"
      ],
      "freshnessRule": "Refresh from Convex before production builds or before using as migration input.",
      "sourceDeployment": "VITE_CONVEX_URL",
      "targetDeployment": null,
      "schemaVersion": "src/schema/substance.schema.ts",
      "editPolicy": "do-not-edit-by-hand",
      "refreshCommand": "node scripts/convex/export-convex-to-json.mjs"
    },
    {
      "id": "reagent-tests-snapshot",
      "path": "src/data/reagentTests.json",
      "role": "derived-api-snapshot",
      "producer": "scripts/data/cacheProtestKitReagentTests.mjs",
      "consumers": [
        "scripts/convex/import-reagent-tests.mjs"
      ],
      "inputs": [
        "src/data/SubstanceIndex.json",
        "ProtestKit API v1 substance responses"
      ],
      "freshnessRule": "Point-in-time snapshot. Refresh only with ProtestKit permission and an explicit operator run, then import it into Convex.",
      "sourceDeployment": "https://protestkit.eu/api/v1",
      "targetDeployment": null,
      "schemaVersion": "ProtestKit API v1 response keyed by DoseWiki slug",
      "editPolicy": "do-not-edit-by-hand",
      "refreshCommand": "npm run reagents:cache"
    },
    {
      "id": "public-substance-index-archive",
      "path": "public/SubstanceIndex.json",
      "role": "archival-public-snapshot",
      "producer": "manual compatibility snapshot copied from a historical substance export",
      "consumers": [
        "external consumers with legacy /SubstanceIndex.json links",
        "About page archival download"
      ],
      "inputs": [
        "historical local substance export"
      ],
      "freshnessRule": "Do not treat as live runtime data. Convex is authoritative for public pages; refresh or remove only through an explicit compatibility decision.",
      "sourceDeployment": "archival local working tree snapshot",
      "targetDeployment": null,
      "schemaVersion": "historical SubstanceIndex.json shape",
      "editPolicy": "do-not-edit-by-hand",
      "refreshCommand": "manual compatibility decision; no routine refresh"
    },
    {
      "id": "substance-index-backups",
      "path": "src/data/backups/*.json",
      "role": "backup",
      "producer": "scripts/prepopulate/*.mjs",
      "consumers": [
        "operators during rollback or comparison"
      ],
      "inputs": [
        "src/data/SubstanceIndex.json",
        "src/data/parsed-sources.json",
        "Convex write target selected by data ops run context"
      ],
      "freshnessRule": "Preserve as point-in-time snapshots; do not treat as current runtime data.",
      "sourceDeployment": "local working tree",
      "targetDeployment": null,
      "schemaVersion": "src/schema/substance.schema.ts",
      "editPolicy": "do-not-edit-by-hand",
      "refreshCommand": "node scripts/prepopulate/prepopulate-high-confidence.mjs --dry-run"
    },
    {
      "id": "parsed-sources",
      "path": "src/data/parsed-sources.json",
      "role": "derived",
      "producer": "scripts/parse-sources.ts",
      "consumers": [
        "scripts/prepopulate/*.mjs",
        "scripts/analyze/*.mjs"
      ],
      "inputs": [
        "src/data/article-sources/*.ts",
        "src/data/tripsit-combos.json",
        "scripts/parsers/**"
      ],
      "freshnessRule": "Refresh after parser changes or source document changes.",
      "sourceDeployment": "src/data/article-sources",
      "targetDeployment": null,
      "schemaVersion": "scripts/parsers/types.ts",
      "editPolicy": "generated-with-manual-preservation",
      "refreshCommand": "npm run parse:sources"
    },
    {
      "id": "article-source-manifest",
      "path": "src/data/articleSourceManifest.json",
      "role": "derived-manifest",
      "producer": "scripts/build/generateArticleManifest.mjs",
      "consumers": [
        "source coverage and article source tooling"
      ],
      "inputs": [
        "archive/drug-info-articles/**"
      ],
      "freshnessRule": "Refresh after archive source files are added, removed, or renamed.",
      "sourceDeployment": "archive/drug-info-articles",
      "targetDeployment": null,
      "schemaVersion": "scripts/build/generateArticleManifest.mjs",
      "editPolicy": "do-not-edit-by-hand",
      "refreshCommand": "node scripts/build/generateArticleManifest.mjs"
    },
    {
      "id": "generator-prompt",
      "path": "src/data/config/generatorPrompt.md",
