#!/usr/bin/env node
/**
 * Report which Convex deployment each URL variable points at, whether the admin
 * tokens in `.env.local` are the ones the target deployment will actually
 * accept, and whether that deployment exposes the Convex functions this
 * checkout defines and calls.
 *
 * Why this exists: an admin token is validated inside the Convex function
 * against the value stored on THAT deployment, so a token is only ever valid
 * for the deployment it was minted on. A local `.env.local` copy that has
 * drifted, or was minted against dev and used against prod, fails at the
 * mutation with a generic authorization error — which reads like "the key is
 * missing" and invites minting yet another key. Nothing here prints a secret;
 * tokens are compared by SHA-1 prefix only.
 *
 * A third invisible failure sits between those two: the running app resolves its
 * browser read target and its privileged write target from different,
 * overlapping variable chains, so a host can read one deployment and write
 * another. Under that split every compare-and-swap write fails as a bogus
 * conflict and the full editor save silently writes the wrong database. The
 * alignment section reports that comparison; /dev and /review refuse to render
 * on it.
 *
 * The same class of invisible failure exists one layer over: the app build never
 * deploys Convex functions, so a deployment can be missing a function the
 * shipped app calls, and production redacts the error to a bare "Server Error".
 * The final section compares the deployment's live function list against this
 * checkout. `npm run convex:check-functions` is the same comparison with a
 * non-zero exit for CI.
 *
 * Usage:
 *   node scripts/recovery/convex/doctor.mjs                # inspect the default deployment
 *   node scripts/recovery/convex/doctor.mjs --deployment=prod
 *   node scripts/recovery/convex/doctor.mjs --url=https://glad-minnow-656.convex.cloud
 *
 * Read-only. It never writes to Convex and never mutates `.env.local`.
 */

import { createHash } from "node:crypto";
import { execFileSync } from "node:child_process";
import path from "node:path";
import { fileURLToPath } from "node:url";
import {
  getAdminIntentEnvVar,
  loadEnvFiles,
} from "../../lib/data-ops-run-context.mjs";
import { buildDriftReport, formatDriftReport } from "../../lib/convex-drift-report.mjs";
import { deploymentNameFromUrl } from "../../lib/convex-function-inventory.mjs";

const REPO_ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../../..");
const CONVEX_URL_KEYS = ["TARGET_CONVEX_URL", "CONVEX_URL", "VITE_CONVEX_URL", "NEXT_PUBLIC_CONVEX_URL"];
const SOURCE_CONVEX_URL_KEYS = ["SOURCE_CONVEX_URL", "CONVEX_PUBLIC_READ_URL", ...CONVEX_URL_KEYS];

/** Every intent a data-ops script can ask for, in the order they appear in the registry. */
const ADMIN_INTENTS = [
  "editorArticleWrite",
  "publicIntakeCreate",
  "promptMigrationWrite",
  "quoteMigrationWrite",
  "profileMediaWrite",
  "replicationMaintenance",
  "articleSourceMigration",
  "productionSync",
  "citationEvidenceWrite",
  "citationEvidenceReview",
  "generatedPublicationWrite",
  "reagentTestImport",
];

/** The fallback every intent silently lands on when its scoped token is absent. */
const LEGACY_ADMIN_KEY = "CONVEX_ADMIN_KEY";

function fingerprint(value) {
  if (!value) return null;
  return createHash("sha1").update(value).digest("hex").slice(0, 12);
}

function deploymentName(url) {
  if (!url) return null;
  try {
    return new URL(url).hostname.split(".")[0];
  } catch {
    return url;
  }
}

function parseArgs(argv) {
  const args = { deployment: null, url: null };
  for (const arg of argv.slice(2)) {
    if (arg.startsWith("--deployment=")) args.deployment = arg.slice("--deployment=".length);
    else if (arg.startsWith("--url=")) args.url = arg.slice("--url=".length);
  }
  return args;
}

/**
 * Ask the deployment itself what it has stored, so local values can be compared
 * against the only copy that matters. Returns null when the CLI cannot reach it
 * — typically because the deploy key in the environment belongs to a different
 * deployment, which is itself the answer to "why was I rejected".
 */
function readDeploymentEnv(name, deployUrl) {
  // Prefer the deploy key whose function-spec response proves it reaches the
  // requested deployment. This keeps credential reads target-bound without
  // ever printing the secret value.
  const target = deploymentName(deployUrl);
  const functionSpec = readFunctionSpec(target, process.env);
  const verifiedDeployKey = functionSpec
    ? process.env[functionSpec.variable]?.trim()
    : null;
  if (verifiedDeployKey) {
    try {
      const raw = execFileSync("bunx", ["convex", "env", "get", name], {
        cwd: REPO_ROOT,
        env: {
          ...process.env,
          CONVEX_DEPLOY_KEY: verifiedDeployKey,
          CONVEX_DEPLOYMENT: "",
        },
        encoding: "utf8",
        stdio: ["ignore", "pipe", "ignore"],
      });
      const trimmed = raw.trim();
      if (trimmed.length > 0) return trimmed;
    } catch {
      // Fall through to an authenticated local Convex session when available.
    }
  }

  const candidates = target ? [`prod:${target}`, `dev:${target}`] : [null];
  for (const deployment of candidates) {
    try {
      const env = { ...process.env, CONVEX_DEPLOY_KEY: "" };
      if (deployment) env.CONVEX_DEPLOYMENT = deployment;
      const raw = execFileSync("bunx", ["convex", "env", "get", name], {
        cwd: REPO_ROOT,
        env,
        encoding: "utf8",
        stdio: ["ignore", "pipe", "ignore"],
      });
      const trimmed = raw.trim();
      if (trimmed.length > 0) return trimmed;
    } catch {
      // Wrong prefix, or no access to that deployment — try the next candidate.
    }
  }
  return null;
}

/**
 * Fetch the inspected deployment's live function list.
 *
 * A deploy key is bound to one deployment and the Convex CLI resolves its target
 * from the key ahead of every flag, so the only honest way to read a chosen
 * deployment is to try each key and keep the response whose own `url` matches.
 * Returns null when no key in the environment reaches it — which is a real
 * answer, not a failure to hide.
 */
function readFunctionSpec(inspectName, env) {
  const candidates = ["CONVEX_DEPLOY_KEY_PROD", "CONVEX_DEPLOY_KEY"];
  for (const variable of candidates) {
    const key = env[variable]?.trim();
    if (!key) continue;
    try {
      const raw = execFileSync("bunx", ["convex", "function-spec"], {
        cwd: REPO_ROOT,
        env: { ...process.env, CONVEX_DEPLOY_KEY: key, CONVEX_DEPLOYMENT: "" },
        encoding: "utf8",
        stdio: ["ignore", "pipe", "ignore"],
        maxBuffer: 64 * 1024 * 1024,
      });
      const reached = deploymentNameFromUrl(JSON.parse(raw).url);
      if (!inspectName || reached === inspectName) return { raw, variable, reached };
    } catch {
      // Key revoked, or the CLI could not reach that deployment — try the next.
    }
  }
  return null;
}

/**
 * The app's own resolution chains, mirroring `lib/convex/runtimeTargets.ts`.
 * These are NOT the script chains above: the running Next app resolves the
 * editor's browser read target and the privileged write target from different,
 * overlapping variable lists, so a host can read one deployment while writing
 * another.
 */
const APP_EDITOR_BROWSER_READ_KEYS = ["NEXT_PUBLIC_CONVEX_URL", "VITE_CONVEX_URL"];
const APP_PRIVILEGED_WRITE_KEYS = ["CONVEX_URL", "VITE_CONVEX_URL", "NEXT_PUBLIC_CONVEX_URL"];

/**
 * Report whether the running app would read and write the same deployment.
 *
 * Under a split, every optimistic-concurrency write fails as a bogus "changed
 * since you loaded it" conflict, and the full editor save — which has no such
 * check — silently writes the deployment the editor is not looking at. The
 * editor and review surfaces refuse to render on a split; this prints the same
 * comparison from the shell.
 */
function reportEditorTargetAlignment(env) {
  const read = resolveFirst(APP_EDITOR_BROWSER_READ_KEYS, env);
  const write = resolveFirst(APP_PRIVILEGED_WRITE_KEYS, env);
  const readName = read ? deploymentName(read.value) : null;
  const writeName = write ? deploymentName(write.value) : null;

  console.log("Editor surface read/write alignment (as the Next app resolves it)");
  console.log(
    `  browser reads      ${(readName ?? "(none)").padEnd(24)} ${read ? `via ${read.key}` : `set none of ${APP_EDITOR_BROWSER_READ_KEYS.join(", ")}`}`,
  );
  console.log(
    `  privileged writes  ${(writeName ?? "(none)").padEnd(24)} ${write ? `via ${write.key}` : `set none of ${APP_PRIVILEGED_WRITE_KEYS.join(", ")}`}`,
  );

  if (!write) {
    console.log(
      "  -> no write target: read-only posture. Valid — this is what the public\n" +
        "     publication deployment (Effect Index) deliberately configures.\n",
    );
    return;
  }

  if (!read) {
    console.log(
      "  -> no browser read target. The editor surfaces cannot load; set\n" +
        "     NEXT_PUBLIC_CONVEX_URL.\n",
    );
    return;
  }

  if (readName === writeName) {
    console.log(`  -> aligned: both target ${readName}.\n`);
    return;
  }

  console.log(
    `  -> SPLIT: the editor would read ${readName} and write ${writeName}.\n` +
      "     Every inline edit fails as a spurious conflict and the full article save\n" +
      "     silently writes the deployment you are not looking at. /dev and /review\n" +
      "     refuse to render on this configuration. Point CONVEX_URL and\n" +
      "     NEXT_PUBLIC_CONVEX_URL at the same deployment.\n",
  );
}

function resolveFirst(keys, env) {
  for (const key of keys) {
    const value = env[key]?.trim();
    if (value) return { key, value };
  }
  return null;
}

/** Env vars the retired sign-in paths read; the app ignores them now. */
const RETIRED_AUTH_KEYS = [
  "ADMIN_PASSWORD",
  "DEV_PASSWORD_KEYS",
  "AUTH_ADMIN_EMAILS",
  "AUTH_GITHUB_ID",
  "AUTH_GITHUB_SECRET",
  "GITHUB_ID",
  "GITHUB_SECRET",
  "GITHUB_TOKEN",
];

/**
 * Sign-in is username + password against Convex memberships. The only
 * auth-specific env the app needs is the session secret; the credentials
 * lookup rides on the write target and admin key reported elsewhere.
 */
function reportSignInEnv(env) {
  const secret = resolveFirst(["AUTH_SECRET", "NEXTAUTH_SECRET"], env);
  console.log("Sign-in env (username + password accounts live in Convex memberships)");
  console.log(
    `  session secret     ${secret ? `set via ${secret.key}` : "(unset) -> only NODE_ENV=development can issue sessions"}`,
  );
  console.log(
    "  accounts           seed with: node scripts/auth/seed-admin-accounts.mjs --write ... (needs TARGET_CONVEX_URL + CONVEX_ADMIN_KEY)",
  );
  const retired = RETIRED_AUTH_KEYS.filter((key) => env[key]?.trim());
  if (retired.length > 0) {
    console.log(
      `  -> ignored: ${retired.join(", ")} still set. Nothing reads them; remove them so nobody\n` +
        "     mistakes an env password or OAuth app for a working sign-in.",
    );
  }
  console.log("");
}

function main() {
  const args = parseArgs(process.argv);
  loadEnvFiles({ rootDir: REPO_ROOT, env: process.env });
  const env = process.env;

  console.log("Convex credential doctor — read-only, no secrets printed\n");

  console.log("URL variables (write targets resolve in this order; first non-empty wins)");
  for (const key of CONVEX_URL_KEYS) {
    const value = env[key]?.trim();
    console.log(`  ${key.padEnd(24)} ${value ? deploymentName(value) : "(unset)"}`);
  }
  const target = resolveFirst(CONVEX_URL_KEYS, env);
  console.log(
    `  -> writes target: ${target ? `${deploymentName(target.value)} (via ${target.key})` : "NONE — scripts will refuse to run"}\n`,
  );

  console.log("URL variables (read sources resolve in this order)");
  for (const key of SOURCE_CONVEX_URL_KEYS) {
    const value = env[key]?.trim();
    console.log(`  ${key.padEnd(24)} ${value ? deploymentName(value) : "(unset)"}`);
  }
  const source = resolveFirst(SOURCE_CONVEX_URL_KEYS, env);
  console.log(
    `  -> reads source:  ${source ? `${deploymentName(source.value)} (via ${source.key})` : "NONE"}\n`,
  );

  reportEditorTargetAlignment(env);
  reportSignInEnv(env);

  const inspectUrl = args.url ?? target?.value ?? null;
  const inspectName = deploymentName(inspectUrl);
  console.log(
    `Admin tokens, compared against deployment ${inspectName ?? "(unknown)"}\n` +
      "  A token is only valid on the deployment it was minted on. MISMATCH means the\n" +
      "  script will authenticate locally and then be rejected by the mutation.\n",
  );

  const legacyLocal = env[LEGACY_ADMIN_KEY]?.trim() || null;
  const legacyRemote = readDeploymentEnv(LEGACY_ADMIN_KEY, inspectUrl);
  const remoteReachable = legacyRemote !== null;

  // Mirrors convex/lib/adminIntentTokens.ts: the deployment accepts a token
  // that equals its own scoped var for that intent, OR its legacy admin key.
  // Locally, a script sends the scoped var if set and otherwise the legacy one.
  // A row is only usable when the value actually sent clears one of those.
  const rows = [];
  for (const intent of ADMIN_INTENTS) {
    const envVar = getAdminIntentEnvVar(intent);
    const scopedLocal = env[envVar]?.trim() || null;
    const sent = scopedLocal ?? legacyLocal;
    const scopedRemote = remoteReachable ? readDeploymentEnv(envVar, inspectUrl) : null;

    let status;
    if (!sent) {
      status = "MISSING — no scoped token and no fallback";
    } else if (!remoteReachable) {
      status = scopedLocal ? "unverified" : `via ${LEGACY_ADMIN_KEY}, unverified`;
    } else if (scopedRemote && sent === scopedRemote) {
      status = "OK (scoped)";
    } else if (legacyRemote && sent === legacyRemote) {
      status = `OK (accepted as ${LEGACY_ADMIN_KEY})`;
    } else {
      status = scopedLocal
        ? "REJECTED — value matches neither the deployment's scoped nor legacy key"
        : `REJECTED — ${LEGACY_ADMIN_KEY} does not match this deployment`;
    }

    rows.push({ intent, envVar, local: fingerprint(sent), status });
  }

  const width = Math.max(...rows.map((row) => row.envVar.length));
  for (const row of rows) {
    console.log(
      `  ${row.envVar.padEnd(width)}  ${(row.local ?? "-").padEnd(12)}  ${row.status}`,
    );
  }

  console.log(
    `\n  ${LEGACY_ADMIN_KEY.padEnd(width)}  ${(fingerprint(legacyLocal) ?? "-").padEnd(12)}  ` +
      (legacyLocal && legacyRemote
        ? legacyLocal === legacyRemote
          ? "OK — matches the deployment"
          : "MISMATCH — the usual cause of a rejected write, and of minting another key"
        : remoteReachable
          ? "not set on deployment"
          : "unverified — could not read deployment env"),
  );

  if (!remoteReachable) {
    console.log(
      `\nCould not read ${inspectName ?? "the deployment"}'s stored env via the Convex CLI.\n` +
        "The deploy key in this environment probably belongs to a different deployment,\n" +
        "so local tokens could not be verified. Statuses above are local presence only.",
    );
  }

  console.log("\nTo fix a MISMATCH, copy the deployment's own value rather than minting a new key:");
  console.log("  bunx convex env get CONVEX_ADMIN_KEY        # the value that deployment accepts");
  console.log("  bunx convex env set CONVEX_ADMIN_TOKEN_<INTENT> <value>   # scope it per intent");

  console.log("");
  const spec = readFunctionSpec(inspectName, env);
  if (!spec) {
    console.log(
      `Convex function drift — not checked against ${inspectName ?? "the deployment"}\n` +
        "  No CONVEX_DEPLOY_KEY / CONVEX_DEPLOY_KEY_PROD in this environment reaches it, so\n" +
        "  whether it exposes the functions this checkout calls is UNKNOWN. Reading the live\n" +
        "  function list is the only way to know: the app build never deploys Convex\n" +
        "  functions, and production redacts every error to a bare \"Server Error\".",
    );
  } else {
    console.log(formatDriftReport(buildDriftReport({ repoRoot: REPO_ROOT, spec: spec.raw })));
    console.log(
      `  Read via ${spec.variable}. Fail a build on this with: npm run convex:check-functions -- --prod`,
    );
  }

  console.log("\nSee docs/agents/convex-credentials.md for the full map.");
}

main();
