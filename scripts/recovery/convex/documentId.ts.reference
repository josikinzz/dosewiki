/**
 * Snapshot document id (v6) codec, ported from Convex's convex-backend
 * `crates/value/src/id_v6.rs` and `base32.rs`.
 *
 *   id = base32( VInt(tableNumber) ++ internalId[16] ++ footer[2] )
 *   footer = fletcher16(VInt(tableNumber) ++ internalId) XOR version(0), little endian
 *
 * Base32 is Crockford's alphabet in lowercase (no i, l, o, u) and is decoded
 * strictly: an id is valid only when it re-encodes to the same string.
 *
 * Retained for the hosted recovery export: Convex snapshot import rejects
 * malformed ids and ids whose table number differs from the target table.
 * Recovery distinguishes imported ids from Postgres-minted ids and creates
 * replacements for that snapshot format; the live runtime does not use it.
 */

import { randomBytes } from "node:crypto";

const ALPHABET = "0123456789abcdefghjkmnpqrstvwxyz";
const DECODE = new Int16Array(128).fill(-1);
for (let i = 0; i < ALPHABET.length; i += 1) DECODE[ALPHABET.charCodeAt(i)] = i;

const INTERNAL_ID_LENGTH = 16;
const FOOTER_LENGTH = 2;
const VERSION = 0;
const MIN_BINARY_LENGTH = 1 + INTERNAL_ID_LENGTH + FOOTER_LENGTH;
const MAX_BINARY_LENGTH = 5 + INTERNAL_ID_LENGTH + FOOTER_LENGTH;

export type DataId = { tableNumber: number; internalId: Uint8Array };

function encodedLength(bytes: number): number {
  const tail = [0, 2, 4, 5, 7][bytes % 5];
  return Math.floor(bytes / 5) * 8 + tail;
}

function base32Encode(data: Uint8Array): string {
  let out = "";
  let buffer = 0;
  let bits = 0;
  for (const byte of data) {
    buffer = (buffer << 8) | byte;
    bits += 8;
    while (bits >= 5) {
      out += ALPHABET[(buffer >>> (bits - 5)) & 31];
      bits -= 5;
    }
  }
  if (bits > 0) out += ALPHABET[(buffer << (5 - bits)) & 31];
  return out;
}

function base32Decode(text: string): Uint8Array | null {
  const bytes = new Uint8Array(Math.floor((text.length * 5) / 8));
  let buffer = 0;
  let bits = 0;
  let index = 0;
  for (let i = 0; i < text.length; i += 1) {
    const code = text.charCodeAt(i);
    const value = code < 128 ? DECODE[code] : -1;
    if (value < 0) return null;
    buffer = ((buffer << 5) | value) & 0xffff;
    bits += 5;
    if (bits >= 8) {
      bytes[index] = (buffer >>> (bits - 8)) & 0xff;
      index += 1;
      bits -= 8;
    }
  }
  return bytes;
}

function fletcher16(data: Uint8Array): number {
  let c0 = 0;
  let c1 = 0;
  for (const byte of data) {
    c0 = (c0 + byte) & 0xff;
    c1 = (c1 + c0) & 0xff;
  }
  return (c1 << 8) | c0;
}

function vintEncode(value: number): number[] {
  const out: number[] = [];
  let n = value >>> 0;
  for (;;) {
    if (n < 0x80) {
      out.push(n);
      return out;
    }
    out.push((n & 0x7f) | 0x80);
    n >>>= 7;
  }
}

function vintDecode(data: Uint8Array): { value: number; length: number } | null {
  let value = 0;
  for (let i = 0; i < 5; i += 1) {
    if (i >= data.length) return null;
    const byte = data[i];
    value |= (byte & 0x7f) << (i * 7);
    if (byte < 0x80) return { value: value >>> 0, length: i + 1 };
  }
  return null;
}

function encodeDataId(id: DataId): string {
  if (!Number.isInteger(id.tableNumber) || id.tableNumber <= 0) throw new Error(`Invalid table number ${id.tableNumber}`);
  if (id.internalId.length !== INTERNAL_ID_LENGTH) throw new Error(`Internal id must be ${INTERNAL_ID_LENGTH} bytes`);
  const head = vintEncode(id.tableNumber);
  const body = new Uint8Array(head.length + INTERNAL_ID_LENGTH + FOOTER_LENGTH);
  body.set(head, 0);
  body.set(id.internalId, head.length);
  const footer = fletcher16(body.subarray(0, head.length + INTERNAL_ID_LENGTH)) ^ VERSION;
  body[head.length + INTERNAL_ID_LENGTH] = footer & 0xff;
  body[head.length + INTERNAL_ID_LENGTH + 1] = (footer >>> 8) & 0xff;
  return base32Encode(body);
}

/** Strict decode: null unless `text` is a canonical v6 snapshot id. */
export function decodeDataId(text: string): DataId | null {
  if (text.length < encodedLength(MIN_BINARY_LENGTH) || text.length > encodedLength(MAX_BINARY_LENGTH)) return null;
  const bytes = base32Decode(text);
  if (!bytes) return null;
  const head = vintDecode(bytes);
  if (!head || head.value === 0) return null;
  const end = head.length + INTERNAL_ID_LENGTH + FOOTER_LENGTH;
  if (bytes.length !== end) return null;
  const expected = fletcher16(bytes.subarray(0, head.length + INTERNAL_ID_LENGTH)) ^ VERSION;
  const footer = bytes[end - 2] | (bytes[end - 1] << 8);
  if (footer !== expected) return null;
  const id = { tableNumber: head.value, internalId: bytes.slice(head.length, head.length + INTERNAL_ID_LENGTH) };
  return encodeDataId(id) === text ? id : null;
}

/** A fresh snapshot id for the table numbered `tableNumber`. */
export function mintDataIdForTable(tableNumber: number): string {
  return encodeDataId({ tableNumber, internalId: new Uint8Array(randomBytes(INTERNAL_ID_LENGTH)) });
}
