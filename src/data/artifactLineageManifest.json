        "avatar provenance review",
        "scripts/contributors/generate-avatars-from-replications.test.ts"
      ],
      "inputs": [
        "production contributorProfiles and publishable replication rows",
        "src/data/config/effectIndexFeaturedReplications.json",
        "production-resolved replication media bytes"
