# Environment Variables Template
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local or any file with actual secrets

# =============================================================================
# SITE FLAVOR (publication identity)
# =============================================================================
# Build-time selector for which publication this build is compiled against.
# Public pages are prerendered, so the identity is baked into the static output.
# Unset / empty / unrecognised => dose.wiki (the default). `effectindex` => Effect Index.
# A typo silently falls back to dose.wiki, so double-check this on Effect Index deploys.
# NEXT_PUBLIC_SITE_FLAVOR=effectindex

# =============================================================================
# CONVEX DATABASE
# =============================================================================
# Development Convex URL
VITE_CONVEX_URL=https://your-dev-instance.convex.cloud

# Optional explicit browser-safe Convex URL for the Next.js `/dev` shell.
# If omitted, the Next editor route falls back to `VITE_CONVEX_URL`.
NEXT_PUBLIC_CONVEX_URL=https://your-dev-instance.convex.cloud

# Explicit server-side target for privileged writes and auth membership sync.
# If omitted, compatibility mode falls back to VITE_CONVEX_URL, then NEXT_PUBLIC_CONVEX_URL.
CONVEX_URL=https://your-dev-instance.convex.cloud

# Optional override for public App Router reads.
# Use this when you want local public pages to mirror production content
# while keeping the `/dev` shell and save flows on your dev deployment.
CONVEX_PUBLIC_READ_URL=https://your-prod-instance.convex.cloud

# Admin API key for batch scripts (set this in Convex dashboard: Settings > Environment Variables)
# Required for mutations that modify data (substance index, prompts, quotes, etc.)
CONVEX_ADMIN_KEY=...

# =============================================================================
# EXTERNAL APIS (Server-side only - no VITE_ prefix)
# =============================================================================
# OpenRouter API for AI generation
OPENROUTER_API_KEY=sk-or-v1-...

# Scry read-only SQL-over-HTTPS access for public source research
SCRY_API_KEY=...

# Upstash Redis for rate limiting
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# =============================================================================
# PRIVATE TRIP REPORT INTAKE - Convex/Vercel
# =============================================================================
# Private public-submission intake uses the server Convex write capability above.
# Configure CONVEX_URL (or VITE_CONVEX_URL / NEXT_PUBLIC_CONVEX_URL) and
# CONVEX_ADMIN_KEY on Vercel. A scoped editor token can also be supplied via:
# CONVEX_ADMIN_TOKEN_EDITOR_ARTICLE_WRITE=...
# CONVEX_ADMIN_TOKEN_REAGENT_TEST_IMPORT=...

# Optional HMAC secret for storing IP hashes without storing raw IP addresses.
# If omitted, submissions are stored without IP hash metadata.
TRIP_REPORT_SUBMISSIONS_IP_HASH_SECRET=replace-with-a-long-random-string

# =============================================================================
# AUTHENTICATION - Auth.js (Active Next.js path)
# =============================================================================
# Auth.js sign-in for the Next.js migration shell.
# `AUTH_SECRET` is required for preview/production sessions.
# Editor password env vars such as ADMIN_PASSWORD or JOSIE enable credentials sign-in.
# `AUTH_ADMIN_EMAILS` bootstraps initial Convex membership roles for OAuth users.
# Runtime env validation is centralized in `lib/runtime/envContract.ts`.
AUTH_SECRET=replace-with-a-long-random-string
AUTH_ADMIN_EMAILS=you@example.com

# Optional GitHub OAuth provider.
# AUTH_GITHUB_ID=Iv1...
# AUTH_GITHUB_SECRET=...

# Deprecated compatibility aliases still accepted by the runtime env contract.
# Prefer AUTH_SECRET for new deployments; use AUTH_GITHUB_ID / AUTH_GITHUB_SECRET only for OAuth.
# NEXTAUTH_SECRET=replace-with-a-long-random-string
# GITHUB_ID=Iv1...
# GITHUB_SECRET=...

# Prevent local Auth.js warnings and set callback origin.
NEXTAUTH_URL=http://localhost:3000

# =============================================================================
# AUTHENTICATION - Editor Credentials (Server-side only)
# =============================================================================
# Auth.js credentials provider backed by server-side env vars.
# In preview/production, AUTH_SECRET must also be configured.
ADMIN_PASSWORD=...

# Additional user passwords (optional)
# ZENBY=...
# KOSM=...

# =============================================================================
# DEVELOPMENT
# =============================================================================
# Additional password keys (comma-separated)
# DEV_PASSWORD_KEYS=USER1,USER2

# Enables `/api/test-env` in production. Leave unset unless actively debugging.
# ENABLE_TEST_ENV=false
