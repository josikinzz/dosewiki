{
  "name": "dose-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "scripts": {
    "predev": "node scripts/build/prebuild.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build/prebuild.mjs",
    "build": "vite build && node scripts/build/buildPrerenderedPages.mjs && node scripts/build/cleanupPrebuildArtifacts.mjs",
    "build:profile": "vite build --debug",
    "prebuild:inline": "node scripts/build/prebuild.mjs --no-sitemap",
    "build:inline": "vite build --mode inline --outDir dist-inline",
    "preview": "vite preview",
    "generate:smiles": "node scripts/data/generateSmilesMap.mjs",
    "merge:articles": "node scripts/data/merge-articles-json.mjs",
    "generate:manifest": "node scripts/build/generateArticleManifest.mjs",
    "generate:schema": "tsx scripts/generate/generateSchemaUtils.ts",
    "parse:sources": "tsx scripts/parse-sources.ts --stats",
    "parse:sources:verbose": "tsx scripts/parse-sources.ts --verbose --stats",
    "prepopulate:high-confidence": "node scripts/prepopulate-high-confidence.mjs",
    "batch:extract": "node scripts/batch-extract-quotes.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@iconify-json/lucide": "^1.2.85",
    "@iconify/react": "^6.0.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@tanstack/react-query": "^5.90.16",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.1",
    "circle-flags": "^2.8.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.31.4",
    "d3": "^7.9.0",
    "diff": "^8.0.2",
    "framer-motion": "^11.0.0",
    "lg-thumbnail": "^1.2.1",
    "lg-video": "^1.4.0",
    "lg-zoom": "^1.3.0",
    "lightgallery": "^2.9.0",
    "lucide-react": "^0.562.0",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.70.0",
    "react-markdown": "^10.1.0",
    "react-masonry-css": "^1.0.16",
    "react-simple-code-editor": "^0.14.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tokenx": "^1.2.1",
    "yaml": "^2.8.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3": "^7.4.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "@vitest/coverage-v8": "^4.0.16",
    "autoprefixer": "^10.4.19",
    "baseline-browser-mapping": "^2.9.14",
    "eslint": "^9.39.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.0.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.39",
    "sharp": "^0.34.4",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.52.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.16"
  }
}
