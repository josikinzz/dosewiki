# Vercel Policy Guardrails - Pre-commit Hook
# Prevents commits that contain secrets, unsafe patterns, or policy violations

echo "🔒 Running Vercel policy guardrails..."

# 1. Check for secrets in staged files
./.husky/check-secrets.sh
if [ $? -ne 0 ]; then
  echo "❌ Secret detection failed. Please remove secrets before committing."
  exit 1
fi

# 2. Run ESLint on staged files
# Warnings are printed but only errors block the commit.
# The vendored OpenChemLib package owns its generated declarations and test lint
# policy; root ESLint must not rewrite or reject its pinned upstream sources.
STAGED_TS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' | grep -v '^vendor/openchemlib/' || true)

if [ -n "$STAGED_TS_FILES" ]; then
  echo "📝 Linting TypeScript files..."
  printf '%s\n' "$STAGED_TS_FILES" | xargs npx eslint --no-warn-ignored
  if [ $? -ne 0 ]; then
    echo "❌ ESLint failed. Please fix issues before committing."
    exit 1
  fi
fi

# 3. Check for .env files being committed
STAGED_ENV=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.env' | grep -v '\.env\.example' || true)
if [ -n "$STAGED_ENV" ]; then
  echo "❌ Attempting to commit .env files: $STAGED_ENV"
  echo "   Add these to .gitignore or use .env.example for templates"
  exit 1
fi

echo "✅ All pre-commit checks passed!"
