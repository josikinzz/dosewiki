# Environment Variables Template
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local or any file with actual secrets

# =============================================================================
# SITE FLAVOR (publication identity)
# =============================================================================
# Build-time selector for which publication this build is compiled against.
# Public pages are prerendered, so the identity is baked into the static output.
# Unset / empty / unrecognised => dose.wiki (the default). `effectindex` => Effect Index.
# A typo silently falls back to dose.wiki, so double-check this on Effect Index deploys.
# NEXT_PUBLIC_SITE_FLAVOR=effectindex

# =============================================================================
# CONVEX DATABASE
# =============================================================================
# Every environment uses the production Convex deployment. Keep all read and
# runtime capability URLs aligned; `enchanted-echidna-791` is retired.
VITE_CONVEX_URL=https://glad-minnow-656.convex.cloud

# Explicit browser-safe URL for the protected `/dev` shell.
NEXT_PUBLIC_CONVEX_URL=https://glad-minnow-656.convex.cloud

# Server-side runtime target for privileged writes and auth membership sync.
CONVEX_URL=https://glad-minnow-656.convex.cloud

# Public App Router reads use the same production deployment.
CONVEX_PUBLIC_READ_URL=https://glad-minnow-656.convex.cloud

# Production scripts require an explicit write target even when the runtime
# variables above are aligned. Run `npm run convex:doctor` before every write.
TARGET_CONVEX_URL=https://glad-minnow-656.convex.cloud

# Admin API key for batch scripts (set this in Convex dashboard: Settings > Environment Variables)
# Required for mutations that modify data (substance index, prompts, quotes, etc.)
CONVEX_ADMIN_KEY=...

# =============================================================================
# EXTERNAL APIS (Server-side only - no VITE_ prefix)
# =============================================================================
# OpenRouter API for AI generation
OPENROUTER_API_KEY=sk-or-v1-...

# Scry read-only SQL-over-HTTPS access for public source research
SCRY_API_KEY=...

# Upstash Redis for rate limiting
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# =============================================================================
# PUBLIC ANALYTICS
# =============================================================================
# PostHog project key (`phc_...`). Loaded only on the approved public hosts in
# `lib/next/analyticsHostPolicy.ts` (dose.wiki, www.dose.wiki), so the admin host,
# Vercel previews and the `/dev` editorial surface never initialise PostHog.
# Leave this unset to disable PostHog entirely — including on the credential-free
# Effect Index deployment, which must not carry it.
# Pageviews only: autocapture, session replay, surveys and exception capture are
# all disabled in code, and persistence is cookieless localStorage.
# NEXT_PUBLIC_POSTHOG_KEY=phc_...

# =============================================================================
# PRIVATE TRIP REPORT INTAKE - Convex/Vercel
# =============================================================================
# Private public-submission intake uses the server Convex write capability above.
# Configure CONVEX_URL (or VITE_CONVEX_URL / NEXT_PUBLIC_CONVEX_URL) and
# CONVEX_ADMIN_KEY on Vercel. A scoped editor token can also be supplied via:
# CONVEX_ADMIN_TOKEN_EDITOR_ARTICLE_WRITE=...
# CONVEX_ADMIN_TOKEN_REAGENT_TEST_IMPORT=...

# Optional HMAC secret for storing IP hashes without storing raw IP addresses.
# If omitted, submissions are stored without IP hash metadata.
TRIP_REPORT_SUBMISSIONS_IP_HASH_SECRET=replace-with-a-long-random-string

# =============================================================================
# AUTHENTICATION - Auth.js
# =============================================================================
# Sign-in is username + password. Accounts (including their scrypt password
# hashes and roles) live in the Convex `memberships` table, never in env.
# Seed the first admin accounts with `node scripts/auth/seed-admin-accounts.mjs`
# (see docs/agents/convex-credentials.md). The sign-in lookup uses
# CONVEX_ADMIN_KEY and the Convex URL configured above.
# `AUTH_SECRET` signs sessions and is required outside `NODE_ENV=development`.
# Runtime env validation is centralized in `lib/runtime/envContract.ts`.
AUTH_SECRET=replace-with-a-long-random-string

# Deprecated alias still accepted by the runtime env contract. Prefer AUTH_SECRET.
# NEXTAUTH_SECRET=replace-with-a-long-random-string

# Prevent local Auth.js warnings and set callback origin.
NEXTAUTH_URL=http://localhost:3000

# =============================================================================
# DEVELOPMENT
# =============================================================================
# Enables `/api/test-env` in production. Leave unset unless actively debugging.
# ENABLE_TEST_ENV=false

# =============================================================================
# REPLICATION MEDIA DELIVERY (Cloudflare R2)
# =============================================================================
# Delivery base URL for R2-backed replication media. This is a CONVEX
# DEPLOYMENT variable, not a Next.js one: the resolver runs inside Convex
# queries, so set it with `npx convex env set REPLICATION_MEDIA_BASE_URL ...`
# on prod:glad-minnow-656. Setting it here does nothing at runtime; the line
# exists so the variable and its rollback semantics are documented. Unsetting
# the deployment variable disables R2-first resolution everywhere and falls
# back to Convex Storage (the migration's rollback switch).
# REPLICATION_MEDIA_BASE_URL=https://<delivery-host>
