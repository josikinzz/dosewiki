{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dose.wiki/schemas/identity-social-production-completion-report.schema.json",
  "title": "Identity and social production completion report",
  "type": "object",
  "required": ["artifactType", "schemaVersion", "generatedAt", "target", "inputs", "expected", "actual", "coverage", "safety", "gates", "complete", "reportSha256"],
  "properties": {
    "artifactType": { "const": "identity-social-production-completion-report" },
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "target": {
      "type": "object",
      "required": ["convexDeployment", "readOnly"],
      "properties": { "convexDeployment": { "const": "glad-minnow-656" }, "readOnly": { "const": true } },
      "additionalProperties": false
    },
    "inputs": { "type": "object", "required": ["projectionSha256", "receiptSidecarSha256", "ledgerSha256", "operationReceiptSetSha256", "expectedItemSetSha256", "profileMergeLedgerSha256", "profileCurationLedgerSha256", "supplementalSupersessionSetSha256"] },
    "expected": { "type": "object" },
    "actual": { "type": "object" },
    "coverage": {
      "type": "object",
      "required": ["pendingActionableItemIds", "legacyCanonicalProfileBatchExceptions", "unexpectedOrInvalidEvidence", "activeOperationProofs", "supersedingOperationProofs"],
      "properties": {
        "pendingActionableItemIds": { "type": "array", "items": { "type": "string" } },
        "legacyCanonicalProfileBatchExceptions": { "type": "array", "items": { "type": "string" } },
        "unexpectedOrInvalidEvidence": { "type": "array", "items": { "type": "string" } },
        "activeOperationProofs": { "type": "array", "items": { "type": "object" } },
        "supersedingOperationProofs": { "type": "array", "items": { "type": "object" } }
      }
    },
    "safety": {
      "type": "object",
      "required": ["mutationsInvoked", "sourceDeletionOperations", "basis"],
      "properties": { "mutationsInvoked": { "const": 0 }, "sourceDeletionOperations": { "const": 0 }, "basis": { "type": "string" } }
    },
    "gates": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "complete": { "type": "boolean" },
    "reportSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
