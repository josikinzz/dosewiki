      "producer": "editorial prompt authors",
      "consumers": [
        "scripts/migrate/migrate-prompts-to-convex.mjs"
      ],
      "inputs": [
        "editorial prompt source edits"
      ],
      "freshnessRule": "Compare against Convex before migrating; Convex is runtime source after migration.",
      "sourceDeployment": "local working tree",
      "targetDeployment": "CONVEX_URL or VITE_CONVEX_URL",
      "schemaVersion": "convex/prompts.ts",
      "editPolicy": "editable-with-convex-migration",
      "refreshCommand": "node scripts/migrate/compare-prompts.mjs"
    },
    {
      "id": "section-prompts",
      "path": "src/data/config/sectionPrompts/*.md",
      "role": "prompt-source",
      "producer": "editorial prompt authors",
      "consumers": [
        "scripts/migrate/migrate-prompts-to-convex.mjs",
        "section generation prompts"
      ],
      "inputs": [
        "editorial prompt source edits",
        "src/data/config/promptRegistry.json"
      ],
      "freshnessRule": "Compare against Convex before migrating; Convex is runtime source after migration.",
      "sourceDeployment": "local working tree",
      "targetDeployment": "CONVEX_URL or VITE_CONVEX_URL",
      "schemaVersion": "convex/prompts.ts",
      "editPolicy": "editable-with-convex-migration",
      "refreshCommand": "node scripts/migrate/compare-prompts.mjs"
    },
    {
      "id": "formal-citations-prompts",
      "path": "src/data/config/formalCitationsPrompts/*.md",
      "role": "prompt-source",
      "producer": "editorial prompt authors",
      "consumers": [
        "scripts/migrate/migrate-prompts-to-convex.mjs",
        "formal citations agent prompts"
      ],
      "inputs": [
        "editorial prompt source edits",
        "src/data/config/promptRegistry.json"
      ],
      "freshnessRule": "Compare against Convex before migrating; Convex is runtime source after migration.",
      "sourceDeployment": "local working tree",
      "targetDeployment": "CONVEX_URL or VITE_CONVEX_URL",
      "schemaVersion": "convex/prompts.ts",
      "editPolicy": "editable-with-convex-migration",
      "refreshCommand": "node scripts/migrate/compare-prompts.mjs"
    },
    {
      "id": "user-profiles-migration-seed",
      "path": "src/data/config/userProfiles.json",
      "role": "migration-seed",
      "producer": "legacy contributor profile export",
      "consumers": [
        "scripts/convex/migrate-user-profiles-to-convex.mjs",
        "profile migration/backfill operators"
      ],
      "inputs": [
        "legacy local contributor profile data"
      ],
      "freshnessRule": "Do not treat as current runtime data; Convex contributorProfiles is authoritative after migration.",
      "sourceDeployment": "local working tree",
      "targetDeployment": "CONVEX_URL or VITE_CONVEX_URL",
      "schemaVersion": "convex/contributorProfiles.ts",
      "editPolicy": "migration-seed-only",
      "refreshCommand": "node scripts/convex/migrate-user-profiles-to-convex.mjs --dry-run"
    },
    {
      "id": "article-media-curation",
      "path": "src/data/config/articleMediaCuration.json",
      "role": "reviewed-migration-input",
      "producer": "article media curation reviewers",
      "consumers": [
        "scripts/replications/migrate-article-media.mjs",
        "scripts/effects/upgrade-embed-resolutions.mjs"
      ],
      "inputs": [
        "production subjectiveEffects and effectIndexArticles media inventory captured 2026-08-11",
        "production replication rows and contributor profiles",
        "per-asset attribution, role, effect, and pixel-match review"
      ],
      "freshnessRule": "Preserve as a dated review snapshot. Amend an entry only after its evidence is re-reviewed; do not infer current production state from this file.",
      "sourceDeployment": "https://glad-minnow-656.convex.cloud (production snapshot, 2026-08-11)",
      "targetDeployment": "TARGET_CONVEX_URL selected by scripts/replications/migrate-article-media.mjs",
      "schemaVersion": "scripts/replications/article-media-planning.mjs",
      "editPolicy": "reviewed-evidence-only",
      "refreshCommand": "Manually review a fresh production inventory, then preview it with node scripts/replications/migrate-article-media.mjs --inventory=<path> --uploads-dir=<path>"
    },
    {
      "id": "article-media-migration-decisions",
      "path": "src/data/config/articleMediaMigrationDecisions.json",
      "role": "reviewed-migration-decisions",
      "producer": "site owner and article media migration maintainers",
      "consumers": [
        "scripts/replications/migrate-article-media.mjs"
      ],
      "inputs": [
        "src/data/config/articleMediaCuration.json",
        "explicit owner rulings relayed 2026-08-11",
        "near-duplicate review and storage-id resolution against production",
        "sha-256-pinned recovered media"
      ],
      "freshnessRule": "Update only for an explicit owner ruling or a reviewed production re-resolution. Preserve historical rulings and verified duplicate decisions.",
      "sourceDeployment": "https://glad-minnow-656.convex.cloud plus explicit owner rulings",
      "targetDeployment": "TARGET_CONVEX_URL selected by scripts/replications/migrate-article-media.mjs",
      "schemaVersion": "scripts/replications/article-media-planning.mjs",
      "editPolicy": "owner-rulings-and-verified-production-facts-only",
      "refreshCommand": "Re-resolve production facts, then preview with node scripts/replications/migrate-article-media.mjs --inventory=<path> --uploads-dir=<path>"
    },
    {
