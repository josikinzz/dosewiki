{
  "name": "dose-wiki",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.5",
  "scripts": {
    "dev": "next dev",
    "next:dev": "next dev",
    "build": "next build",
    "next:build": "next build",
    "rdkit:assets": "node tools/copyRdkitAssets.mjs",
    "predev": "node tools/copyRdkitAssets.mjs",
    "prebuild": "node tools/copyRdkitAssets.mjs",
    "start": "next start",
    "next:start": "next start",
    "generate:smiles": "bun scripts/data/generateSmilesMap.mjs",
    "molecules:setup-venv": "python3.13 -m venv .venv-molecules && .venv-molecules/bin/pip install -r scripts/chemistry/requirements.txt",
    "molecules:smiles-coverage": "node scripts/data/resolveSmilesCoverage.mjs",
    "molecules:merge-smiles": "node scripts/data/mergeGeneratedSmiles.mjs",
    "molecules:generate": "node scripts/data/generateMoleculeSvgs.mjs",
    "molecules:generate-classes": "${MOLECULE_PYTHON:-.venv-molecules/bin/python} scripts/chemistry/render_class_structures.py --manual src/data/indexes/chemicalIndexManual.json --outdir public/molecules/classes --overrides src/data/molecules/class-overrides",
    "molecules:seed-convex": "bun scripts/chemistry/seed-convex-molecules.ts",
    "convex:set-chemical-class": "node scripts/convex/set-chemical-class.mjs",
    "molecules:pack": "cd public && rm -f dosewiki-molecules.zip && zip -q -r -X dosewiki-molecules.zip molecules -i '*.svg' && cd ../src/data/molecules && zip -q -r -X ../../../public/dosewiki-molecules.zip molecules-standard -i '*.svg' && echo 'Built public/dosewiki-molecules.zip (brand + standard colourways)'",
    "generate:favicons": "node scripts/data/generate-further-reading-favicons.mjs",
    "generate:mantra-spiral": "bun scripts/data/generate-mantra-spiral.ts",
    "merge:articles": "bun scripts/data/merge-articles-json.mjs",
    "generate:manifest": "bun scripts/build/generateArticleManifest.mjs",
    "generate:schema": "bun scripts/generate/generateSchemaUtils.ts",
    "generate:subjective-effects-provenance": "node scripts/convex/generate-subjective-effects-provenance.mjs",
    "provenance:check": "node scripts/data/verifyGeneratedDataProvenance.mjs",
    "parse:sources": "bun scripts/parse-sources.ts --stats",
    "parse:sources:verbose": "bun scripts/parse-sources.ts --verbose --stats",
    "cleanup:metrics": "bun scripts/analyze/cleanup-metrics.ts",
    "features:reachability": "node scripts/analyze/feature-reachability.mjs --check",
    "audit:public-prose-artifacts": "node scripts/analyze/audit-public-prose-artifact-language.mjs --fail --convex-url=https://glad-minnow-656.convex.cloud",
    "audit:public-prose-named-sources": "node scripts/analyze/audit-public-prose-artifact-language.mjs --fail --named-sources --convex-url=https://glad-minnow-656.convex.cloud",
    "audit:plagiarism": "node scripts/analyze/audit-dose-table-tolerance-plagiarism.mjs",
    "audit:plagiarism:other-sections": "node scripts/analyze/audit-dose-table-tolerance-plagiarism.mjs --scope=other-sections",
    "plagiarism:apply-rewrites": "node scripts/convex/apply-dose-table-tolerance-plagiarism-rewrites.mjs",
    "hygiene:check": "node scripts/util/clean-local-artifacts.mjs",
    "hygiene:clean": "node scripts/util/clean-local-artifacts.mjs --clean",
    "batch:extract": "bun scripts/batch/batch-extract-quotes.mjs",
    "batch:summary": "bun scripts/batch/batch-generate-summary.mjs",
    "batch:proposal": "node scripts/batch/generate-section-proposal.mjs",
    "batch:publish-reviewed-section": "node scripts/batch/proposal/publish-reviewed-section.mjs",
    "batch:tolerance": "bun scripts/batch/batch-generate-tolerance.mjs",
    "batch:legality": "bun scripts/batch/batch-generate-legality.mjs",
    "batch:harm-potential": "bun scripts/batch/batch-generate-harm-potential.mjs",
    "batch:history-culture": "bun scripts/batch/batch-generate-history-culture.mjs",
    "batch:dosage-duration": "bun scripts/batch/batch-generate-dosage-duration.mjs",
    "batch:dosage-duration:export": "node scripts/batch/export-dosage-duration-rewrite-openrouter.mjs",
    "batch:dosage-duration:run": "node scripts/batch/run-dosage-duration-rewrite-openrouter.mjs",
    "batch:dosage-duration:apply": "node scripts/batch/apply-dosage-duration-rewrite-results.mjs",
    "batch:watch": "node scripts/batch/watch-batch-progress.mjs",
    "prepopulate:high-confidence": "bun scripts/prepopulate/prepopulate-high-confidence.mjs",
    "prepopulate:dosage-duration": "bun scripts/prepopulate/prepopulate-dosage-duration.mjs",
    "prepopulate:interactions-tripsit": "bun scripts/prepopulate/prepopulate-interactions-tripsit.mjs",
    "prepopulate:legality": "bun scripts/prepopulate/prepopulate-legality.mjs",
    "citations:formal": "node scripts/citations/formal-citations.mjs",
    "citations:apply-workbench": "node scripts/citations/apply-workbench-draft.mjs",
    "citations:rebase-workbench": "node scripts/citations/rebase-workbench-draft.mjs",
    "citations:export-workbench-task": "node scripts/citations/export-workbench-task-from-convex.mjs",
    "citations:campaign": "node .pi/skills/pi-citation-workflow/scripts/citation-campaign.mjs",
    "test:citations:campaign": "node --test .pi/skills/pi-citation-workflow/scripts/citation-campaign.test.mjs",
    "citations:archive-production-dataset": "node scripts/citations/archive-production-dataset.mjs",
    "legality:export": "node scripts/legality/export-run-packet.mjs",
    "legality:validate": "bun scripts/legality/validate-draft.ts",
    "legality:apply": "node scripts/legality/apply-draft.mjs",
    "legality:cite": "node scripts/legality/apply-citations.mjs",
    "scry:query": "node scripts/scry-query.mjs",
    "prototype:trip-report-submissions": "bun src/features/reports/prototypes/trip-report-submission-intake.prototype.ts",
    "migrate:trip-reports": "node scripts/migrate/migrate-trip-reports.mjs",
    "migrate:effects": "node scripts/migrate/migrate-effects.mjs",
    "prompts:compare": "node scripts/migrate/compare-prompts.mjs",
    "prompts:migrate": "node scripts/migrate/migrate-prompts-to-convex.mjs",
    "convex:sync-production": "node scripts/convex/sync-convex-to-production.mjs",
    "convex:export": "node scripts/convex/export-convex-to-json.mjs",
    "convex:fill-route-gaps": "node scripts/convex/fill-insufflated-rectal-route-gaps.mjs",
    "convex:apply-subjective-effects": "bun scripts/convex/apply-subjective-effects-import.ts",
    "convex:migrate-user-profiles": "node scripts/convex/migrate-user-profiles-to-convex.mjs",
    "test:workflow": "node scripts/test/run-workflow-tests.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "theme:tokens:check": "bun src/theme/tokenAudit.ts --check",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:convex": "tsc --noEmit -p tsconfig.convex.json",
    "lint": "eslint src/ lib/ auth.ts middleware.ts",
    "lint:fix": "eslint src/ lib/ auth.ts middleware.ts --fix",
    "lint:api": "eslint src/app/api/",
    "lint:scripts": "eslint scripts --ext .js,.mjs,.cjs,.ts,.tsx --ignore-pattern 'scripts/deprecated/**' --ignore-pattern 'scripts/**/archive/**'",
    "lint:all": "npm run lint && npm run lint:api && npm run lint:scripts",
    "verify:app": "npm run test && npm run lint && npm run lint:api && npm run typecheck && npm run build",
    "verify:workflow": "npm run test:workflow && npm run lint:scripts && npm run typecheck:scripts && npm run typecheck:convex && npm run cleanup:metrics -- --check && npm run provenance:check",
    "verify:all": "npm run verify:app && npm run verify:workflow",
    "prepare": "husky || true",
    "security:check": "./.husky/check-secrets.sh"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@iconify-json/lucide": "^1.2.108",
    "@iconify/react": "^6.0.2",
    "@openrouter/sdk": "0.12.35",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@rdkit/rdkit": "^2025.3.4-1.0.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-query": "^5.100.11",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.42.1",
    "diff": "^9.0.0",
    "framer-motion": "^12.39.0",
    "lucide-react": "^1.16.0",
    "mermaid": "^11.15.0",
    "next": "^16.2.6",
    "next-auth": "^4.24.14",
    "openchemlib": "^9.23.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.0",
    "react-markdown": "^10.1.0",
    "react-masonry-css": "^1.0.16",
    "react-simple-code-editor": "^0.14.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tokenx": "^1.3.0",
    "yaml": "^2.9.0",
    "yet-another-react-lightbox": "^3.32.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.17",
    "raw-loader": "^4.0.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "fast-uri": "3.1.3",
    "flatted": "3.4.2",
    "picomatch": "4.0.5",
    "postcss": "8.5.17",
    "undici": "7.28.0"
  },
  "description": "Next.js + Convex application for the dose.wiki harm-reduction knowledge base. The public site renders substance articles, subjective effects, trip reports, classifications, and editor-managed project content from Convex. The protected `/dev` surface provides editorial tools for maintaining that data.",
  "main": "eslint.config.mjs",
  "directories": {
    "doc": "docs",
    "lib": "lib"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josikinzz/dosewiki-admin.git"
  },
  "keywords": [],
