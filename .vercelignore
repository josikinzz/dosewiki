# Dependencies and generated output
node_modules/
.next/
dist/
# The repository-owned OpenChemLib package resolves from committed browser
# artifacts during Vercel's no-Java/GWT install and build.
!vendor/openchemlib/dist/
!vendor/openchemlib/dist/**
dist-inline/
# Anchored: unanchored `coverage/` matches a directory of that name at any
# depth, which excluded src/features/coverage and src/app/about/coverage from
# the Vercel build — the route silently did not exist. Same fix as .gitignore.
/coverage/
.generated/
src/data/.lineage/

# Local deployment and editor state
.git/
.vercel/
.vscode/
.cursor/
.claude/
.codex/
.venv-molecules/
.impeccable.md

# Environment and logs
.env
.env.*
*.log
*.pid
npm-debug.log*
npm-dev.log
npm-dev.err.log

# Operational workspaces not needed for the Next.js production build
archive/
docs/audits/
docs/archive/
learning/
notes-and-plans/
output/
outputs/
quotes/
runs/
# scripts/ is operational EXCEPT the build chain: vercel.json routes every
# build through scripts/deploy/vercel-build.mjs, which runs the drift gate in
# scripts/convex/ whose imports live in scripts/lib/. A blanket `scripts/`
# here made the 2026-07-31 deploys fail with MODULE_NOT_FOUND on a file that
# was committed all along — the upload simply never contained it.
# check-build-command-wiring.mjs now asserts this stays true.
scripts/*
!scripts/deploy/
!scripts/convex/
!scripts/lib/
tmp/
.pi/
.pi-subagents/
package-lock.json
