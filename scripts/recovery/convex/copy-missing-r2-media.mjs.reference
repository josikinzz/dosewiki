#!/usr/bin/env node

/**
 * Copy ledger entries missing from R2 out of Convex Storage and into the
 * content-addressed replication archive. Downloads are hashed before upload;
 * successful objects are recorded in an append-only JSONL result file so the
 * operation can resume safely.
 *
 * Dry run:
 *   node scripts/replications/copy-missing-r2-media.mjs --ledger <ledger.json>
 *
 * Write:
 *   node scripts/replications/copy-missing-r2-media.mjs --ledger <ledger.json> \
 *     --write --confirm-write=copy-missing-r2-media
 */

import { createHash } from "node:crypto";
import { signR2Request } from "../../lib/runtime/r2Signing.mjs";
import { spawn } from "node:child_process";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { Readable } from "node:stream";
import { fileURLToPath } from "node:url";
import { createDataClient, resolvePostgresSource, postgresFingerprintFromUrl } from "../lib/data-client.ts";
import { api } from "../../lib/postgres/runtime/api.ts"
import {
  findRepoRoot,
  getFlagValue,
  hasFlag,
  requireAdminIntentToken,
  loadEnvFiles,
} from "../lib/data-ops-run-context.mjs";

const OPERATION = "copy-missing-r2-media";
const DEFAULT_CONCURRENCY = 3;
const EXTENSION_BY_CONTENT_TYPE = Object.freeze({
  "image/gif": "gif",
  "image/jpeg": "jpg",
  "image/png": "png",
  "image/webp": "webp",
  "video/mp4": "mp4",
  // Ticket 11: the legacy audio replications that are served only from Convex Storage.
  "audio/ogg": "ogg",
  "audio/mpeg": "mp3",
});
const URL_FIELD_BY_ROLE = Object.freeze({
  main: "url",
  thumbnail: "thumbnail_url",
  preview: "preview_url",
  motion: "motion_url",
  motion_poster: "motion_poster_url",
});

function sha256Hex(value) {
  return createHash("sha256").update(value).digest("hex");
}


function awsEncode(value) {
  return encodeURIComponent(value).replace(/[!'()*]/g, (char) =>
    `%${char.charCodeAt(0).toString(16).toUpperCase()}`,
  );
}


export function contentAddressedKey(entry) {
  if (!/^[0-9a-f]{64}$/.test(entry.sha256)) {
    throw new Error(`Invalid SHA-256 for ${entry.storage_id}: ${entry.sha256}`);
  }
  const ext = EXTENSION_BY_CONTENT_TYPE[entry.contentType];
  if (!ext) throw new Error(`Unsupported content type for ${entry.storage_id}: ${entry.contentType}`);
  return `media/sha256/${entry.sha256.slice(0, 2)}/${entry.sha256}.${ext}`;
}

/** One R2 object per unique digest; preserve every Convex storage ID it covers. */
export function collectMissingObjects(entries) {
  const bySha = new Map();
  for (const entry of entries) {
    if (entry.status !== "missing") continue;
    const prior = bySha.get(entry.sha256);
    if (prior) {
      if (prior.size !== entry.size || prior.contentType !== entry.contentType) {
        throw new Error(`Conflicting metadata for SHA-256 ${entry.sha256}`);
      }
      if (!prior.storage_ids.includes(entry.storage_id)) prior.storage_ids.push(entry.storage_id);
      continue;
    }
    const object = {
      sha256: entry.sha256,
      size: entry.size,
      contentType: entry.contentType,
      storage_id: entry.storage_id,
      storage_ids: [entry.storage_id],
      source_url: entry.source_url,
    };
    object.key = contentAddressedKey(object);
    bySha.set(entry.sha256, object);
  }
  return [...bySha.values()];
}


function objectUrl(endpoint, bucket, key) {
  const base = endpoint.replace(/\/+$/, "");
  return `${base}/${awsEncode(bucket)}/${key.split("/").map(awsEncode).join("/")}`;
}

async function signedFetch(config, method, key, { headers = {}, body = null, payloadHash = sha256Hex("") } = {}) {
  const url = objectUrl(config.endpoint, config.bucket, key);
  const signedHeaders = signR2Request({
    method,
    url,
    headers,
    payloadHash,
    accessKeyId: config.accessKeyId,
    secretAccessKey: config.secretAccessKey,
  });
  return fetch(url, {
    method,
    headers: signedHeaders,
    body,
    ...(body ? { duplex: "half" } : {}),
  });
}

async function headObject(config, object) {
  const response = await signedFetch(config, "HEAD", object.key);
  if (response.status === 404) return null;
  if (!response.ok) throw new Error(`R2 HEAD ${object.key}: ${response.status} ${response.statusText}`);
  const size = Number(response.headers.get("content-length"));
  if (size !== object.size) {
    throw new Error(`R2 size mismatch for ${object.key}: expected ${object.size}, got ${size}`);
  }
  return {
    size,
    sha256: response.headers.get("x-amz-meta-sha256"),
  };
}

async function hashResponse(response, label) {
  if (!response.ok || !response.body) {
    throw new Error(`${label}: ${response.status} ${response.statusText}`);
  }
  const hash = createHash("sha256");
  let size = 0;
  for await (const chunk of Readable.fromWeb(response.body)) {
    hash.update(chunk);
    size += chunk.length;
  }
  return { sha256: hash.digest("hex"), size };
}
async function runCurl(args, label) {
  await new Promise((resolve, reject) => {
    const child = spawn("curl", ["--http1.1", ...args], { stdio: ["ignore", "pipe", "pipe"] });
    let output = "";
    child.stdout.on("data", (chunk) => { output += chunk; });
    child.stderr.on("data", (chunk) => { output += chunk; });
    child.on("error", reject);
    child.on("close", (code) => {
      if (code === 0) resolve();
      else reject(new Error(`${label} exited ${code}: ${output.slice(0, 500)}`));
    });
  });
}


async function verifyExistingObject(config, object, head) {
  if (head.sha256 === object.sha256) return;
  const response = await signedFetch(config, "GET", object.key, { payloadHash: sha256Hex("") });
  const actual = await hashResponse(response, `R2 GET ${object.key}`);
  if (actual.sha256 !== object.sha256 || actual.size !== object.size) {
    throw new Error(`Existing R2 object does not match ${object.key}`);
  }
}

async function downloadConvexObject(object, tempDir) {
  const tempPath = path.join(tempDir, `${object.sha256}.part`);
  fs.rmSync(tempPath, { force: true });
  const url = new URL(object.source_url);
  if (!url.hostname.endsWith(".convex.cloud") || !url.pathname.startsWith("/api/storage/")) {
    throw new Error(`Unsafe Convex storage URL for ${object.storage_id}: ${url}`);
  }
  await runCurl(
    ["--silent", "--show-error", "--fail", "--location", "--remove-on-error", "--output", tempPath, url.href],
    `curl GET ${object.storage_id}`,
  );
  const hash = createHash("sha256");
  let size = 0;
  for await (const chunk of fs.createReadStream(tempPath)) {
    hash.update(chunk);
    size += chunk.length;
  }
  const actualSha = hash.digest("hex");
  if (size !== object.size || actualSha !== object.sha256) {
    fs.rmSync(tempPath, { force: true });
    throw new Error(
      `Convex bytes mismatch for ${object.storage_id}: expected ${object.size}/${object.sha256}, got ${size}/${actualSha}`,
    );
  }
  return tempPath;
}

async function uploadObject(config, object, filename) {
  if (!globalThis.Bun?.S3Client) {
    throw new Error("Run this migration with Bun so large R2 writes use multipart uploads.");
  }
  config.s3 ??= new Bun.S3Client({
    accessKeyId: config.accessKeyId,
    secretAccessKey: config.secretAccessKey,
    endpoint: config.endpoint,
    bucket: config.bucket,
  });
  const written = await config.s3.write(object.key, Bun.file(filename), {
    type: object.contentType,
    partSize: 10 * 1024 * 1024,
    queueSize: 4,
    retry: 8,
  });
  // Bun 1.3.5 reports 0 for successful R2 multipart writes; HEAD is the
  // authoritative size check immediately below.
  if (written !== 0 && written !== object.size) {
    throw new Error(`R2 write length mismatch for ${object.key}: expected ${object.size}, got ${written}`);
  }
  const head = await headObject(config, object);
  if (!head) throw new Error(`R2 read-back failed for ${object.key}`);
}

function readJsonLines(filename) {
  if (!fs.existsSync(filename)) return [];
  return fs.readFileSync(filename, "utf8").split(/\r?\n/).filter(Boolean).map((line) => JSON.parse(line));
}

async function mapConcurrent(items, concurrency, worker) {
  let cursor = 0;
  const runners = Array.from({ length: Math.min(concurrency, items.length) }, async () => {
    while (true) {
      const index = cursor++;
      if (index >= items.length) return;
      await worker(items[index], index);
    }
  });
  await Promise.all(runners);
}
async function withRetries(label, operation, attempts = 5) {
  let lastError;
  for (let attempt = 1; attempt <= attempts; attempt += 1) {
    try {
      return await operation();
    } catch (error) {
      lastError = error;
      if (attempt === attempts) break;
      const delay = 500 * (2 ** (attempt - 1));
      console.warn(`${label}: attempt ${attempt}/${attempts} failed (${error.message}); retrying in ${delay}ms`);
      await new Promise((resolve) => setTimeout(resolve, delay));
    }
  }
  throw lastError;
}


function writeCombinedManifest(sourcePath, outputPath, objects) {
  const records = readJsonLines(sourcePath);
  const knownKeys = new Set(records.map((record) => record.key ?? record.Key ?? record.object_key ?? record.name ?? record.path));
  for (const object of objects) {
    if (!knownKeys.has(object.key)) records.push({ key: object.key, size: object.size });
  }
  fs.mkdirSync(path.dirname(outputPath), { recursive: true });
  const part = `${outputPath}.part`;
  fs.writeFileSync(part, `${records.map((record) => JSON.stringify(record)).join("\n")}\n`);
  fs.renameSync(part, outputPath);
}

async function main() {
  const argv = process.argv.slice(2);
  const root = findRepoRoot();
  loadEnvFiles({ rootDir: root, env: process.env });
  const ledgerPath = getFlagValue(argv, "--ledger");
  if (!ledgerPath) throw new Error("Usage: --ledger <r2-media-ledger.json> [--write --confirm-write=copy-missing-r2-media]");
  const ledger = JSON.parse(fs.readFileSync(ledgerPath, "utf8"));
  const readUrl = resolvePostgresSource({ argv }).url;
  if (!readUrl) throw new Error("Set --source-url or SOURCE_POSTGRES_URL for the live database read.");
  if (ledger.postgres_target && ledger.postgres_target !== postgresFingerprintFromUrl(readUrl)) throw new Error("Media ledger belongs to another Postgres source.");
  let objects = collectMissingObjects(ledger.entries);
  const limitFlag = getFlagValue(argv, "--limit");
  if (limitFlag) objects = objects.slice(0, Number(limitFlag));
  const concurrency = Number(getFlagValue(argv, "--concurrency") ?? DEFAULT_CONCURRENCY);
  if (!Number.isInteger(concurrency) || concurrency < 1 || concurrency > 16) throw new Error("--concurrency must be 1..16");
  const resultsPath = path.resolve(getFlagValue(argv, "--results") ?? path.join(path.dirname(ledgerPath), "r2-copy-results.jsonl"));
  const manifestOutput = path.resolve(getFlagValue(argv, "--manifest-output") ?? path.join(path.dirname(ledgerPath), "r2-manifest-after-copy.jsonl"));

  console.log(`Missing ledger slots : ${ledger.entries.filter((entry) => entry.status === "missing").length}`);
  console.log(`Unique R2 objects    : ${objects.length}`);
  console.log(`Bytes                : ${objects.reduce((sum, object) => sum + object.size, 0)}`);
  console.log(`Concurrency          : ${concurrency}`);
  console.log(`Results              : ${resultsPath}`);
  if (!hasFlag(argv, "--write")) {
    console.log("Dry run: no R2 writes. Re-run with --write --confirm-write=copy-missing-r2-media.");
    return;
  }
  if (getFlagValue(argv, "--confirm-write") !== OPERATION) {
    throw new Error(`Refusing R2 writes without --confirm-write=${OPERATION}`);
  }

  const config = {
    accessKeyId: process.env.CLOUDFLARE_R2_ACCESS_KEY_ID,
    secretAccessKey: process.env.CLOUDFLARE_R2_SECRET_ACCESS_KEY,
    endpoint: process.env.CLOUDFLARE_R2_S3_ENDPOINT,
    bucket: process.env.CLOUDFLARE_R2_BUCKET,
  };
  for (const [name, value] of Object.entries(config)) {
    if (!value) throw new Error(`Missing R2 configuration: ${name}`);
  }
  const { token: apiKey } = requireAdminIntentToken("replicationMaintenance");
  const wantedShas = new Set(objects.map((object) => object.sha256));
  const relevantEntries = ledger.entries.filter(
    (entry) => entry.status === "missing" && wantedShas.has(entry.sha256),
  );
  const resolvedRows = [];
  const readClient = createDataClient({ target: readUrl }).client;
  await mapConcurrent([...new Set(relevantEntries.map((entry) => entry.id))], 12, async (id) => {
    const row = await readClient.query(api.replications.getResolvedById, { apiKey, id });
    if (!row) throw new Error(`Replication row disappeared: ${id}`);
    resolvedRows.push(row);
  });
  const rowById = new Map(resolvedRows.map((row) => [row._id, row]));
  objects = collectMissingObjects(
    relevantEntries.map((entry) => ({
      ...entry,
      source_url: rowById.get(entry.id)?.[URL_FIELD_BY_ROLE[entry.role]],
    })),
  );
  const missingSource = objects.filter((object) => !object.source_url);
  if (missingSource.length) {
    throw new Error(`${missingSource.length} object(s) have no resolved Convex source URL`);
  }
  fs.mkdirSync(path.dirname(resultsPath), { recursive: true });
  const completed = new Map(readJsonLines(resultsPath).map((record) => [record.key, record]));
  const pending = objects.filter((object) => !completed.has(object.key));
  const tempDir = fs.mkdtempSync(path.join(os.tmpdir(), "dosewiki-r2-copy-"));
  let finished = objects.length - pending.length;
  const failures = [];
  console.log(`Previously completed  : ${finished}`);
  console.log(`Pending               : ${pending.length}`);
  try {
    await mapConcurrent(pending, concurrency, async (object) => {
      try {
        const status = await withRetries(object.key, async () => {
          const head = await headObject(config, object);
          if (head) {
            await verifyExistingObject(config, object, head);
            return "already-present";
          }
          const tempPath = await downloadConvexObject(object, tempDir);
          try {
            await uploadObject(config, object, tempPath);
          } finally {
            fs.rmSync(tempPath, { force: true });
          }
          return "uploaded";
        }, 8);
        const record = { ...object, status, verified_at: new Date().toISOString() };
        fs.appendFileSync(resultsPath, `${JSON.stringify(record)}\n`);
        finished += 1;
        console.log(`${finished}/${objects.length} ${status.padEnd(15)} ${object.key} ${object.size}`);
      } catch (error) {
        failures.push({ key: object.key, error: error.message });
        console.error(`FAILED ${object.key}: ${error.message}`);
      }
    });
  } finally {
    fs.rmSync(tempDir, { recursive: true, force: true });
  }
  if (failures.length) {
    console.error(`${failures.length} object(s) exhausted retries; rerun to resume them.`);
  }

  const latest = new Map(readJsonLines(resultsPath).map((record) => [record.key, record]));
  const missingResults = objects.filter((object) => !latest.has(object.key));
  if (missingResults.length) throw new Error(`${missingResults.length} object(s) lack a successful result record`);
  writeCombinedManifest(ledger.manifest, manifestOutput, objects);
  console.log(`\nCopied/confirmed: ${objects.length}/${objects.length}`);
  console.log(`Combined manifest: ${manifestOutput}`);
}

const invokedDirectly = process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url);
if (invokedDirectly) {
  main().catch((error) => {
    console.error(error);
    process.exit(1);
  });
}
