      "freshnessRule": "Point-in-time provenance emitted with the generated avatar files. Preserve it with those files; a new confirmed generation run must produce provenance for every new avatar.",
      "sourceDeployment": "TARGET_CONVEX_URL or CONVEX_PUBLIC_READ_URL (production read required by the workflow)",
      "targetDeployment": "TARGET_CONVEX_URL selected by the guarded avatar generation command",
      "schemaVersion": "scripts/contributors/generate-avatar-files.ts",
      "editPolicy": "do-not-edit-by-hand",
      "refreshCommand": "No routine refresh; generated only by a confirmed bun scripts/contributors/generate-avatars-from-replications.ts --write run"
    },
