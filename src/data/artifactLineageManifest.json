{
  "version": 1,
  "description": "Operational lineage for local data artifacts. Convex remains authoritative for live runtime data unless an entry says otherwise.",
  "artifacts": [
    {
      "id": "substance-index-export",
      "path": "src/data/SubstanceIndex.json",
      "role": "derived-export",
      "producer": "scripts/convex/export-convex-to-json.mjs",
      "consumers": [
        "scripts/convex/convex-import-substance-index.mjs",
        "scripts/convex/import-to-convex.mjs",
        "scripts/prepopulate/*.mjs",
        "Next.js static fallback reads"
      ],
      "inputs": [
        "Convex substance records",
        "src/schema/substance.schema.ts"
      ],
      "freshnessRule": "Refresh from Convex before production builds or before using as migration input.",
      "sourceDeployment": "VITE_CONVEX_URL",
      "targetDeployment": null,
      "schemaVersion": "src/schema/substance.schema.ts",
      "editPolicy": "do-not-edit-by-hand",
      "refreshCommand": "node scripts/convex/export-convex-to-json.mjs"
    },
    {
      "id": "reagent-tests-snapshot",
      "path": "src/data/reagentTests.json",
      "role": "derived-api-snapshot",
      "producer": "scripts/data/cacheProtestKitReagentTests.mjs",
      "consumers": [
        "scripts/convex/import-reagent-tests.mjs"
      ],
      "inputs": [
        "src/data/SubstanceIndex.json",
        "ProtestKit API v1 substance responses"
      ],
      "freshnessRule": "Point-in-time snapshot. Refresh only with ProtestKit permission and an explicit operator run, then import it into Convex.",
      "sourceDeployment": "https://protestkit.eu/api/v1",
      "targetDeployment": null,
      "schemaVersion": "ProtestKit API v1 response keyed by DoseWiki slug",
      "editPolicy": "do-not-edit-by-hand",
      "refreshCommand": "npm run reagents:cache"
    },
    {
      "id": "public-substance-index-archive",
      "path": "public/SubstanceIndex.json",
      "role": "archival-public-snapshot",
      "producer": "manual compatibility snapshot copied from a historical substance export",
      "consumers": [
        "external consumers with legacy /SubstanceIndex.json links",
        "About page archival download"
      ],
      "inputs": [
        "historical local substance export"
      ],
      "freshnessRule": "Do not treat as live runtime data. Convex is authoritative for public pages; refresh or remove only through an explicit compatibility decision.",
      "sourceDeployment": "archival local working tree snapshot",
      "targetDeployment": null,
      "schemaVersion": "historical SubstanceIndex.json shape",
      "editPolicy": "do-not-edit-by-hand",
      "refreshCommand": "manual compatibility decision; no routine refresh"
    },
    {
      "id": "substance-index-backups",
      "path": "src/data/backups/*.json",
      "role": "backup",
      "producer": "scripts/prepopulate/*.mjs",
      "consumers": [
        "operators during rollback or comparison"
      ],
      "inputs": [
        "src/data/SubstanceIndex.json",
        "src/data/parsed-sources.json",
        "Convex write target selected by data ops run context"
      ],
      "freshnessRule": "Preserve as point-in-time snapshots; do not treat as current runtime data.",
      "sourceDeployment": "local working tree",
      "targetDeployment": null,
      "schemaVersion": "src/schema/substance.schema.ts",
      "editPolicy": "do-not-edit-by-hand",
      "refreshCommand": "node scripts/prepopulate/prepopulate-high-confidence.mjs --dry-run"
    },
    {
      "id": "parsed-sources",
      "path": "src/data/parsed-sources.json",
      "role": "derived",
      "producer": "scripts/parse-sources.ts",
      "consumers": [
        "scripts/prepopulate/*.mjs",
        "scripts/analyze/*.mjs"
      ],
      "inputs": [
        "src/data/article-sources/*.ts",
        "src/data/tripsit-combos.json",
        "scripts/parsers/**"
      ],
      "freshnessRule": "Refresh after parser changes or source document changes.",
      "sourceDeployment": "src/data/article-sources",
      "targetDeployment": null,
      "schemaVersion": "scripts/parsers/types.ts",
      "editPolicy": "generated-with-manual-preservation",
      "refreshCommand": "npm run parse:sources"
    },
    {
      "id": "article-source-manifest",
      "path": "src/data/articleSourceManifest.json",
      "role": "derived-manifest",
      "producer": "scripts/build/generateArticleManifest.mjs",
      "consumers": [
        "source coverage and article source tooling"
      ],
      "inputs": [
        "archive/drug-info-articles/**"
      ],
      "freshnessRule": "Refresh after archive source files are added, removed, or renamed.",
      "sourceDeployment": "archive/drug-info-articles",
      "targetDeployment": null,
      "schemaVersion": "scripts/build/generateArticleManifest.mjs",
      "editPolicy": "do-not-edit-by-hand",
      "refreshCommand": "node scripts/build/generateArticleManifest.mjs"
    },
    {
      "id": "generator-prompt",
      "path": "src/data/config/generatorPrompt.md",
      "role": "prompt-source",
      "producer": "editorial prompt authors",
      "consumers": [
        "scripts/migrate/migrate-prompts-to-convex.mjs"
      ],
      "inputs": [
        "editorial prompt source edits"
      ],
      "freshnessRule": "Compare against Convex before migrating; Convex is runtime source after migration.",
      "sourceDeployment": "local working tree",
      "targetDeployment": "CONVEX_URL or VITE_CONVEX_URL",
      "schemaVersion": "convex/prompts.ts",
      "editPolicy": "editable-with-convex-migration",
      "refreshCommand": "node scripts/migrate/compare-prompts.mjs"
    },
    {
      "id": "section-prompts",
      "path": "src/data/config/sectionPrompts/*.md",
      "role": "prompt-source",
      "producer": "editorial prompt authors",
      "consumers": [
        "scripts/migrate/migrate-prompts-to-convex.mjs",
        "section generation prompts"
      ],
      "inputs": [
        "editorial prompt source edits",
        "src/data/config/promptRegistry.json"
      ],
      "freshnessRule": "Compare against Convex before migrating; Convex is runtime source after migration.",
      "sourceDeployment": "local working tree",
      "targetDeployment": "CONVEX_URL or VITE_CONVEX_URL",
      "schemaVersion": "convex/prompts.ts",
      "editPolicy": "editable-with-convex-migration",
      "refreshCommand": "node scripts/migrate/compare-prompts.mjs"
    },
    {
      "id": "formal-citations-prompts",
      "path": "src/data/config/formalCitationsPrompts/*.md",
      "role": "prompt-source",
      "producer": "editorial prompt authors",
      "consumers": [
        "scripts/migrate/migrate-prompts-to-convex.mjs",
        "formal citations agent prompts"
      ],
      "inputs": [
        "editorial prompt source edits",
        "src/data/config/promptRegistry.json"
      ],
      "freshnessRule": "Compare against Convex before migrating; Convex is runtime source after migration.",
      "sourceDeployment": "local working tree",
      "targetDeployment": "CONVEX_URL or VITE_CONVEX_URL",
      "schemaVersion": "convex/prompts.ts",
      "editPolicy": "editable-with-convex-migration",
      "refreshCommand": "node scripts/migrate/compare-prompts.mjs"
    },
    {
      "id": "user-profiles-migration-seed",
      "path": "src/data/config/userProfiles.json",
      "role": "migration-seed",
      "producer": "legacy contributor profile export",
      "consumers": [
        "scripts/convex/migrate-user-profiles-to-convex.mjs",
        "profile migration/backfill operators"
      ],
      "inputs": [
        "legacy local contributor profile data"
      ],
      "freshnessRule": "Do not treat as current runtime data; Convex contributorProfiles is authoritative after migration.",
      "sourceDeployment": "local working tree",
      "targetDeployment": "CONVEX_URL or VITE_CONVEX_URL",
      "schemaVersion": "convex/contributorProfiles.ts",
      "editPolicy": "migration-seed-only",
      "refreshCommand": "node scripts/convex/migrate-user-profiles-to-convex.mjs --dry-run"
    },
    {
      "id": "schema-generated-helpers",
      "path": "src/data/schema/*.generated*.ts",
      "role": "derived-code",
      "producer": "scripts/generate/generateSchemaUtils.ts",
      "consumers": [
        "src/data/schema/index.ts",
        "editor form schema tooling"
      ],
      "inputs": [
        "src/schema/substance.schema.ts",
        "scripts/generate/schemaGenerationPolicy.ts"
      ],
      "freshnessRule": "Refresh after article schema shape changes.",
      "sourceDeployment": "src/schema/substance.schema.ts",
      "targetDeployment": null,
      "schemaVersion": "src/schema/substance.schema.ts",
      "editPolicy": "do-not-edit-by-hand",
      "refreshCommand": "npm run generate:schema"
    },
    {
      "id": "schema-generated-field-registry",
      "path": "src/data/schema/fieldRegistry.generated/*.ts",
      "role": "derived-code",
      "producer": "scripts/generate/generateSchemaUtils.ts",
      "consumers": [
        "src/data/schema/fieldRegistry.generated.ts",
        "editor form schema tooling"
      ],
      "inputs": [
        "src/schema/substance.schema.ts",
        "scripts/generate/schemaGenerationPolicy.ts"
      ],
      "freshnessRule": "Refresh after article schema shape changes.",
      "sourceDeployment": "src/schema/substance.schema.ts",
      "targetDeployment": null,
      "schemaVersion": "src/schema/substance.schema.ts",
      "editPolicy": "do-not-edit-by-hand",
      "refreshCommand": "npm run generate:schema"
    },
    {
      "id": "chemical-class-index",
      "path": "src/data/indexes/chemicalIndexManual.json",
      "role": "authored-taxonomy-config",
      "producer": "chemical taxonomy maintainers",
      "consumers": [
        "src/data/indexes/chemicalClassLookup.ts",
        "lib/convex/publicChemicalClassIndex.ts",
        "chemical-class molecule rendering and editor tooling"
      ],
      "inputs": [
        "reviewed chemical class definitions, aliases, and structures",
        "article chemical_class values"
      ],
      "freshnessRule": "Update deliberately when the reviewed chemical-class taxonomy changes, then regenerate class molecule structures.",
      "sourceDeployment": "local working tree",
      "targetDeployment": null,
      "schemaVersion": "src/data/builders/chemicalClassTree.ts",
      "editPolicy": "editable-by-chemical-taxonomy-maintainers",
      "refreshCommand": "npm run molecules:generate-classes"
    },
    {
      "id": "generated-smiles-overrides",
      "path": "src/data/mappings/generatedSmiles.json",
      "role": "derived-mapping",
      "producer": "scripts/data/mergeGeneratedSmiles.mjs",
      "consumers": [
        "scripts/data/resolveSmilesCoverage.mjs",
        "scripts/data/buildMoleculePack.ts"
      ],
      "inputs": [
        "notes-and-plans/reports/smiles-gap-fills/batch-*-output.json",
        "RDKit validation"
      ],
      "freshnessRule": "Refresh after reviewed SMILES gap-fill batches change or molecule coverage is regenerated.",
      "sourceDeployment": "reviewed local gap-fill outputs",
      "targetDeployment": null,
      "schemaVersion": "scripts/data/mergeGeneratedSmiles.mjs",
      "editPolicy": "do-not-edit-by-hand",
      "refreshCommand": "npm run molecules:merge-smiles"
    },
    {
      "id": "opsin-smiles-map",
      "path": "src/data/mappings/iupacSmilesMap.json",
      "role": "derived-mapping",
      "producer": "scripts/data/generateSmilesMap.mjs",
      "consumers": [
        "scripts/chemistry/identifier-provenance.mjs",
        "article chemistry identifier enrichment"
      ],
      "inputs": [
        "src/data/SubstanceIndex.json",
        "OPSIN web service responses"
      ],
      "freshnessRule": "Refresh after IUPAC names change in the local SubstanceIndex export or when missing OPSIN resolutions should be retried.",
      "sourceDeployment": "src/data/SubstanceIndex.json and OPSIN",
      "targetDeployment": null,
      "schemaVersion": "scripts/chemistry/identifier-provenance.mjs",
      "editPolicy": "generated-with-manual-preservation",
      "refreshCommand": "npm run generate:smiles"
    },
    {
      "id": "data-artifact-lineage-manifest",
      "path": "src/data/artifactLineageManifest.json",
      "role": "provenance-contract",
      "producer": "data workflow maintainers",
      "consumers": [
        "scripts/lib/data-artifact-lineage.mjs",
        "scripts/data/verifyGeneratedDataProvenance.mjs",
        "npm run hygiene:check"
      ],
      "inputs": [
        "generated data workflow ownership decisions",
        "README.md",
        "AGENTS.md",
        "scripts/README.md"
      ],
      "freshnessRule": "Update when a generated or operational local data artifact, producer command, input, or edit policy changes.",
      "sourceDeployment": "local working tree",
      "targetDeployment": null,
      "schemaVersion": "scripts/lib/data-artifact-lineage.mjs",
      "editPolicy": "editable-by-data-workflow-maintainers",
      "refreshCommand": "npm run provenance:check"
    }
  ]
}
