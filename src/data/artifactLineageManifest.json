      "sourceDeployment": "production contributor and replication data plus cited public evidence",
      "targetDeployment": "TARGET_CONVEX_URL selected by guarded contributor and replication correction commands",
      "schemaVersion": "scripts/contributors/seed-credited-identities-decisions.mjs",
      "editPolicy": "reviewed-evidence-and-owner-decisions-only",
      "refreshCommand": "Review evidence manually, then preview its effect with node scripts/contributors/seed-credited-identities.mjs"
