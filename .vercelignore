# Dependencies and generated output
node_modules/
.next/
.next-editor/
.next-effectindex/
.next-houseclean-dosewiki/
.next-houseclean-effectindex/
.next-houseclean-editor/
.next-semantic-verification/
.next-semantic-verified/
dist/
# The repository-owned OpenChemLib package resolves from committed browser
# artifacts during Vercel's no-Java/GWT install and build.
!vendor/openchemlib/dist/
!vendor/openchemlib/dist/**
# Local compiler tools and intermediates are not runtime fork artifacts.
vendor/openchemlib/.tools/
vendor/openchemlib/gwt-unitCache/
vendor/openchemlib/war/
vendor/openchemlib/lib/java/
# Social cards are served from committed R2 manifests, not workstation renders.
public/images/social/substances/*.jpg
public/images/social/pages/*.jpg
public/images/social/entities/**/*.jpg
dist-inline/
# Anchored: unanchored `coverage/` matches a directory of that name at any
# depth, which excluded src/features/coverage and src/app/about/coverage from
# the Vercel build — the route silently did not exist. Same fix as .gitignore.
/coverage/
.generated/
src/data/.lineage/

# Local deployment and editor state
.git/
.vercel/
.vscode/
.cursor/
.claude/
.codex/
.venv-molecules/
.impeccable.md
.omp/
.impeccable/
.test-evidence/
.unslop/
.agents/
.pi/task-graph.json
.impeccable/critique/
**/settings.local.json
**/.lakebed/

# Environment and logs
.env
.env.*
*.log
*.pid
npm-debug.log*
npm-dev.log
npm-dev.err.log

# Operational workspaces not needed for the Next.js production build
archive/
docs/audits/
docs/archive/
learning/
notes-and-plans/
output/
outputs/
quotes/
runs/
recovery/
# Workstation audit records can contain private operation data.
scripts/data/audit-logs/
scripts/data/backups/
# Keep scripts/ in the upload. Vercel's ignore implementation did not honor
# nested negations reliably, which omitted scripts/deploy/vercel-build.mjs and
# made otherwise valid deployments fail before the build could start.
tmp/
.pi/
.pi-subagents/
package-lock.json
