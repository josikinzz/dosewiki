# Dependencies
node_modules/

# Generated build and test outputs
dist/
dist-inline/
# The DoseWiki-owned OpenChemLib fork commits browser-ready artifacts so app
# builds never require Java/GWT.
!vendor/openchemlib/dist/
!vendor/openchemlib/dist/**
public/share/
.next/
.generated/
# Anchored: unanchored `coverage/` matches a directory of that name at any
# depth, which silently swallowed `src/features/coverage/` — untracked by Git
# and invisible to Tailwind's source scan. Vitest writes here at the root.
/coverage/
src/data/.lineage/
# Generated editor starting-point MOL blocks (rebuilt by `npm run molecules:generate`).
# The authored overrides alongside them ARE tracked.
src/data/molecules/base/
# Standard-colour render for the download pack (rebuilt by `npm run molecules:generate`).
src/data/molecules/molecules-standard/
# Vendored RDKit.js runtime, copied from node_modules by scripts/build/copyRdkitAssets.mjs
# on predev/prebuild — reproducible, so not committed.
public/rdkit/
output/
outputs/

# Logs & env
npm-debug.log*
npm-dev.log
npm-dev.err.log
.DS_Store
.codex-dev.log
.codex-dev.pid
.pi-subagents/
.codex/*.log
.codex/*.pid
.codex/dev-server/*.log
.codex/dev-server/*.pid

# npm lockfile (using bun)
package-lock.json

# Environment files (NEVER commit secrets)
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env*.local
!.env.example

# Editor directories
.idea/
.vscode/

# Local reference archives that are not part of the active runtime
/archive/
/notes-and-plans/archive/
/scripts/deprecated/archive/

# Generated operational exports; tracked legacy exports require retention policy.
notes-and-plans/exports/

# Data ops audit logs and backups (contain sensitive operation data)
scripts/data/audit-logs/
scripts/data/backups/

# Quote files (Convex-only, not bundled)
quotes/

# Prompt files (Convex-only, not bundled)
src/data/config/sectionPrompts/*.md
src/data/config/generatorPrompt.md
.vercel
.lakebed/
**/.lakebed/
.impeccable.md
tmp/
# Local Java/GWT toolchains used only to rebuild the OpenChemLib fork.
vendor/openchemlib/.tools/

# Personal learning workspace (teach skill) — never commit
learning/

# Molecule SVG generation Python venv
.venv-molecules/
__pycache__/
/runs/legality/

# Runtime lock for the headless pi citation loop (held by a live process)
.pi-loop.json.lock
