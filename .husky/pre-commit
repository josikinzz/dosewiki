./.husky/check-secrets.sh
if [ $? -ne 0 ]; then
  echo "Secret detection failed. Remove secrets before committing."
  exit 1
fi

STAGED_TS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' | grep -v '^vendor/openchemlib/' || true)

if [ -n "$STAGED_TS_FILES" ]; then
  echo "Linting TypeScript files..."
  printf '%s\n' "$STAGED_TS_FILES" | xargs npx eslint --no-warn-ignored
  if [ $? -ne 0 ]; then
    echo "ESLint failed. Please fix issues before committing."
    exit 1
  fi
fi

STAGED_ENV=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.env' | grep -v '\.env\.example' || true)
if [ -n "$STAGED_ENV" ]; then
  echo "Attempting to commit .env files: $STAGED_ENV"
  echo "   Add these to .gitignore or use .env.example for templates"
  exit 1
fi
