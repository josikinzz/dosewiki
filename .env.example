# Environment Variables Template
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local or any file with actual secrets

# =============================================================================
# CONVEX DATABASE
# =============================================================================
# Development Convex URL
VITE_CONVEX_URL=https://your-dev-instance.convex.cloud

# =============================================================================
# EXTERNAL APIS (Server-side only - no VITE_ prefix)
# =============================================================================
# OpenRouter API for AI generation
OPENROUTER_API_KEY=sk-or-v1-...

# Upstash Redis for rate limiting
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# =============================================================================
# AUTHENTICATION - WorkOS AuthKit (Recommended)
# =============================================================================
# WorkOS authentication for the frontend.
# These are auto-provisioned by Convex when using authKit in convex.json.
# Get Client ID from Convex dashboard after running `npx convex dev`.
VITE_WORKOS_CLIENT_ID=client_01...
VITE_WORKOS_REDIRECT_URI=http://localhost:5173/callback

# =============================================================================
# AUTHENTICATION - Legacy (Server-side only)
# =============================================================================
# Admin password for protected routes (used when WorkOS is not configured)
ADMIN_PASSWORD=...

# Additional user passwords (optional)
# ZENBY=...
# KOSM=...

# =============================================================================
# DEVELOPMENT
# =============================================================================
# Additional password keys for development (comma-separated)
# DEV_PASSWORD_KEYS=USER1,USER2
