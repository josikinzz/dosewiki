# Environment Variables Template
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local or any file with actual secrets

# =============================================================================
# SITE FLAVOR (publication identity)
# =============================================================================
# Build-time selector for which publication this build is compiled against.
# Public pages are prerendered, so the identity is baked into the static output.
# Unset / empty / unrecognised => dose.wiki (the default). `effectindex` => Effect Index.
# A typo silently falls back to dose.wiki, so double-check this on Effect Index deploys.
# NEXT_PUBLIC_SITE_FLAVOR=effectindex

# Strictly separate editor/public browser artifacts. Production defaults public;
# local development defaults editor. Set the same surface when running next start.
# DOSEWIKI_BUILD_SURFACE=public
# Editor documents and APIs require an application account; static browser assets
# are not secret. Public builds still exclude editorial modules.
# Optional exact comma-separated editor deployment/branch aliases; no wildcards.
# DOSEWIKI_EDITOR_ALLOWED_HOSTS=
# Disable only contextual controls; preserves public content, private drafts,
# and existing workbench access. Requires a rebuild because this is client config.
# NEXT_PUBLIC_CONTEXTUAL_EDITING=false

# Signed cache publication. Never prefix these with NEXT_PUBLIC_ or VITE_.
# Set the same secret on all three Vercel application projects.
# PUBLIC_CACHE_PUBLISH_SECRET=
# Set targets on the editor Vercel project only.
# PUBLIC_CACHE_PUBLISH_TARGETS=https://dose.wiki,https://effectindex.com
# The Postgres publication outbox retains identities and retries failed delivery.

# =============================================================================
# PLANETSCALE POSTGRES
# =============================================================================
# Native authored handlers in server/ run in-process through lib/postgres/runtime/.
# No hosted recovery service or browser database URL selects application data.
DATA_BACKEND=postgres
# Application and ordinary read-only operator connection; never expose publicly.
# POSTGRES_POOLED_URL=postgres://localhost:5432/dosewiki
# Direct connection for the fixed Drizzle migration configuration.
# POSTGRES_DIRECT_URL=postgres://localhost:5432/dosewiki
#
# Privileged operators require an explicit target, reviewed no-write plan, the
# existing production-write allowlist, owner approval, and command confirmations.
# TARGET_POSTGRES_URL=postgres://localhost:5432/dosewiki
# Non-loopback commands additionally require --allow-remote and the exact target host:
# POSTGRES_IMPORT_CONFIRM=<postgres-host>
# The section generation campaign reads only the deployment pinned here (host/database).
# SECTION_GENERATION_PRODUCTION_IDENTITY=<postgres-host>/<database>
# See docs/operations/data-credentials.md; never infer a writer from application URLs.
#
# Keep this set during a write freeze. Only an authorized decision may reopen it.
# DATA_WRITES_FROZEN=1
# General admin tier belongs only on the editor deployment, never public sites.
# Use the operation's DATA_ADMIN_TOKEN_* scoped credential where defined.
# DATA_ADMIN_KEY=
# GENERATED_PUBLICATION_DEPLOYMENT_FINGERPRINT=
#
# lib/postgres/runtime/deploymentEnv.ts requires REPLICATION_MEDIA_BASE_URL for
# complete media reads on every application tier. The signup receiver also needs
# MAILING_LIST_IP_HASH_SECRET and the shared database limiter table.
# MAILING_LIST_IP_HASH_SECRET=
# Feature-specific credentials are server-only. Source configuration changes do
# not authorize provider changes or revoke historical recovery credentials.

# =============================================================================
# EXTERNAL APIS (Server-side only - no VITE_ prefix)
# =============================================================================
# OpenRouter API for AI generation
OPENROUTER_API_KEY=sk-or-v1-...

# Scry read-only SQL-over-HTTPS access for public source research
SCRY_API_KEY=...

# Upstash Redis for rate limiting
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# =============================================================================
# PUBLIC ANALYTICS
# =============================================================================
# PostHog project key (`phc_...`). Loaded only on the approved public hosts in
# `lib/next/analyticsHostPolicy.ts` (dose.wiki, www.dose.wiki), so the admin host,
# Vercel previews and the `/dev` editorial surface never initialise PostHog.
# Leave this unset to disable PostHog entirely — including on the credential-free
# Effect Index deployment, which must not carry it.
# Pageviews only: autocapture, session replay, surveys and exception capture are
# all disabled in code, and persistence is cookieless localStorage.
# NEXT_PUBLIC_POSTHOG_KEY=phc_...

# =============================================================================
# PRIVATE TRIP REPORT INTAKE - Postgres/Vercel
# =============================================================================
# The public deployment uses only this create-only token for report and feedback
# intake. Configure it only on the approved receiver; never prefix with NEXT_PUBLIC_.
# Public factories do not fall back to an editorial admin key.
# DATA_ADMIN_TOKEN_PUBLIC_INTAKE_CREATE=...
# Queue review and moderation stay on the editor server with DATA_ADMIN_KEY.
# DATA_ADMIN_TOKEN_EDITOR_ARTICLE_WRITE=...
# DATA_ADMIN_TOKEN_REAGENT_TEST_IMPORT=...

# Optional HMAC secret for storing IP hashes without storing raw IP addresses.
# If omitted, submissions are stored without IP hash metadata.
TRIP_REPORT_SUBMISSIONS_IP_HASH_SECRET=replace-with-a-long-random-string

# =============================================================================
# AUTHENTICATION - Auth.js
# =============================================================================
# Sign-in is username + password. Accounts (including their scrypt password
# hashes and roles) live in the Postgres memberships table, never in env.
# Seed the first admin accounts with `node scripts/auth/seed-admin-accounts.mjs`
# (see docs/operations/data-credentials.md). The sign-in lookup uses the editor's
# DATA_ADMIN_KEY and server-side Postgres connection.
# `AUTH_SECRET` signs sessions and is required outside `NODE_ENV=development`.
# Runtime env validation is centralized in `lib/runtime/envContract.ts`.
AUTH_SECRET=replace-with-a-long-random-string

# Deprecated alias still accepted by the runtime env contract. Prefer AUTH_SECRET.
# NEXTAUTH_SECRET=replace-with-a-long-random-string

# Prevent local Auth.js warnings and set callback origin.
NEXTAUTH_URL=http://localhost:3000

# Retired login handles that still stamp existing rows (editorial reviews,
# changelog submitters) and belong to a live contributor profile. Groups are
# separated by `;`, handles within a group by `,`; casing is ignored. Set on the
# editor deployment only; it is server-side and never listed in stored aliases.
# LEGACY_CONTRIBUTOR_HANDLE_GROUPS=CURRENT,RETIRED

# =============================================================================
# DEVELOPMENT
# =============================================================================
# Enables `/api/test-env` in production. Leave unset unless actively debugging.
# ENABLE_TEST_ENV=false

# =============================================================================
# REPLICATION MEDIA DELIVERY (Cloudflare R2)
# =============================================================================
# Delivery base URL for R2-backed replication media. Required on every application
# deployment because server/ handlers resolve media in the Postgres runtime.
# Do not unset it as a recovery shortcut; missing configuration fails startup.
# REPLICATION_MEDIA_BASE_URL=https://<delivery-host>
#
# Editor-only S3-compatible credentials for R2 uploads (replication media,
# social cards, image renditions). Never set these on public deployments.
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# CLOUDFLARE_R2_BUCKET=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
